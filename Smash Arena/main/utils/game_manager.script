-- main/game_manager.script
local unit_manager = require "main.unit_manager"
local state = require "main.state"
local sound = require "main.sound"
local rendercam = require "rendercam.rendercam"

local function clear_scene(self)
	-- 1. Удаляем все игровые объекты юнитов
	-- Мы итерируемся по списку all_units, который заполняли при регистрации
	for unit_id, _ in pairs(unit_manager.all_units) do
		if go.exists(unit_id) then
			go.delete(unit_id, true)
		end
	end

	-- 2. Сбрасываем таблицы в unit_manager (teams, all_units, unit_data)
	-- Это аналог команды TRUNCATE в базе данных
	unit_manager.reset()
	state.current_team = 1
end

local function check_game_over(self)
	if not self.battle_active or self.game_over_sent then
		return true
	end

	local player_alive = #unit_manager.teams[1]
	local enemy_alive = #unit_manager.teams[2]

	-- Если у обеих команд еще есть живые бойцы, бой продолжается
	if player_alive > 0 and enemy_alive > 0 then
		return false
	end

	-- Если мы здесь, одна из команд (или обе) потеряла всех бойцов
	self.game_over_sent = true
	self.battle_active = false
	unit_manager.active_unit_id = nil
	msg.post("main:/input_manager", "clear_prediction")
	msg.post("main:/input_manager", "set_target", { id = nil })
	msg.post("/gui#game", "refresh_queue")

	if enemy_alive == 0 and player_alive > 0 then
		-- ИСТИННАЯ ПОБЕДА: только когда все враги мертвы и игрок жив!
		local prestige = math.random(28, 35)
		local coins = math.random(33, 60)
		state.add(prestige, coins, 0)
		msg.post("/gui#game", "game_over", { victory = true, coins = coins, prestige = prestige })
	else
		-- ПОРАЖЕНИЕ: бойцы игрока уничтожены (или взаимное уничтожение 0 vs 0)
		local prestige = math.random(-30, -27)
		local coins = math.random(1, 10)
		msg.post("/gui#game", "game_over", { victory = false, coins = coins, prestige = prestige })
	end

	return true
end

local function perform_ai_turn(self, ai_unit_id)
	local current_battle = self.battle_id
	if not self.battle_active or self.game_over_sent or self.battle_id ~= current_battle then
		return
	end

	local player_units = unit_manager.teams[1]
	if #player_units == 0 then
		check_game_over(self)
		return
	end

	local target_unit_id = player_units[math.random(1, #player_units)]
	if not go.exists(ai_unit_id) or not go.exists(target_unit_id) then return end

	local ai_pos = go.get_world_position(ai_unit_id)
	local target_pos = go.get_world_position(target_unit_id)

	local error_margin = 10 
	local offset = vmath.vector3(
		math.random(-error_margin, error_margin), 
		math.random(-error_margin, error_margin), 
		0
	)

	local messy_target = target_pos + offset
	local final_dir = vmath.normalize(messy_target - ai_pos)
	local start_angle = math.atan2(final_dir.y, final_dir.x) + (math.random() - 0.5) * 2.0 

	local steps = 20
	for i = 1, steps do
		timer.delay(i * 0.06, false, function()
			if not self.battle_active or self.game_over_sent or self.battle_id ~= current_battle or not go.exists(ai_unit_id) then return end
			local ratio = i / steps
			local current_angle = start_angle + (math.atan2(final_dir.y, final_dir.x) - start_angle) * ratio
			local current_dir = vmath.vector3(math.cos(current_angle), math.sin(current_angle), 0)

			msg.post("main:/input_manager", "draw_prediction", { 
				from = go.get_world_position(ai_unit_id), 
				dir = current_dir 
			})
		end)
	end

	local delay_before_shot = steps * 0.05 + 0.4

	timer.delay(delay_before_shot, false, function()
		if not self.battle_active or self.game_over_sent or self.battle_id ~= current_battle or not go.exists(ai_unit_id) then return end

		if math.random(1, 10) < 4 and self.steps_to_next_enemy > 0 then
			self.steps_to_next_enemy = self.steps_to_next_enemy - 1
			perform_ai_turn(self, ai_unit_id)
		else
			msg.post("main:/input_manager", "clear_prediction")
			msg.post(ai_unit_id, "apply_impulse", { vector = final_dir })
		end
	end)
end

local function activate_next_unit(self)
	if not self.battle_active or self.game_over_sent then
		return
	end

	if check_game_over(self) then
		return
	end

	local team_id = state.current_team
	local team = unit_manager.teams[team_id]

	if #team == 0 then
		state.switch_turn()
		team_id = state.current_team
		team = unit_manager.teams[team_id]
		if #team == 0 then
			check_game_over(self)
			return
		end
	end

	for _, unit_id in ipairs(team) do
		if go.exists(unit_id) then
			msg.post(unit_id, "set_active", { active = false })
		end
	end

	local idx = unit_manager.team_indices[team_id] or 1
	if idx > #team then idx = 1 end 

	local next_unit = team[idx]

	if next_unit and go.exists(next_unit) then
		unit_manager.active_unit_id = next_unit
		msg.post("/gui#game", "refresh_queue")

		if team_id == 1 then
			msg.post("main:/input_manager", "set_target", { id = next_unit })
			msg.post(next_unit, "set_active", { active = true })
		else
			msg.post("main:/input_manager", "set_target", { id = nil })
			self.steps_to_next_enemy = 3
			perform_ai_turn(self, next_unit)
			msg.post(next_unit, "set_active", { active = true })
		end

		unit_manager.team_indices[team_id] = (idx % #team) + 1
	else
		unit_manager.active_unit_id = nil
		msg.post("/gui#game", "refresh_queue")
	end
end

function init(self)
	state.load()
	math.randomseed(os.time())
	self.screen_w = sys.get_config_int("display.width", 390)
	self.screen_h = sys.get_config_int("display.height", 780)
	self.battle_id = 0
	self.battle_active = false
	self.game_over_sent = false
end

local function check_and_switch(self)
	local current_battle = self.battle_id
	if not self.battle_active or self.game_over_sent or self.battle_id ~= current_battle then
		return
	end

	if unit_manager.is_everyone_stopped() then
		if check_game_over(self) then
			return
		end
		state.switch_turn()
		msg.post("/gui#game", "show_turn_msg", { team = state.current_team })
		activate_next_unit(self)
	else
		timer.delay(0.2, false, function()
			if self.battle_active and not self.game_over_sent and self.battle_id == current_battle then
				check_and_switch(self)
			end
		end)
	end
end

function on_message(self, message_id, message, sender)
	-- 1. Создание битвы
	if message_id == hash("init_battle") then
		self.battle_id = (self.battle_id or 0) + 1
		self.battle_active = true
		self.game_over_sent = false
		local current_battle = self.battle_id

		unit_manager.reset()

		local padding_x = self.screen_w / 6
		local player_y = -100
		local enemy_y = 100

		local formation_offsets = {
			[1] = { x = math.random(-130, -25), y = math.random(30, 70) },
			[2] = { x = math.random(-60, -25),  y = math.random(70, 170) },
			[3] = { x = math.random(25, 60),   y = math.random(70, 170) },
			[4] = { x = math.random(25, 130),  y = math.random(30, 70) }
		}

		-- Спавн команды ИГРОКА
		for i = 1, 4 do
			local offset = formation_offsets[i]
			local spawn_pos = vmath.vector3(0 + offset.x, player_y - offset.y, 0)

			local h_id = state.active_deck[i]
			local h_level = state.hero_levels[h_id] or 1 

			factory.create("#unit_factory", spawn_pos, nil, { 
				team_type = 1, 
				hero_id = h_id,
				level = h_level
			})
		end

		-- Спавн команды ВРАГА
		for i = 1, 4 do
			local offset = formation_offsets[i]
			local spawn_pos = vmath.vector3(0 + offset.x, enemy_y + offset.y, 0)

			local h_id = state.enemy_deck[i]
			local h_level = (state.enemy_levels and state.enemy_levels[h_id]) or 1

			factory.create("#unit_factory", spawn_pos, nil, { 
				team_type = 2, 
				hero_id = h_id,
				level = h_level
			})
		end

		timer.delay(0.25, false, function()
			if self.battle_active and not self.game_over_sent and self.battle_id == current_battle then
				msg.post("/gui#game", "show_turn_msg", { team = state.current_team })
				activate_next_unit(self)
			end
		end)

	elseif message_id == hash("cleanup_battle") then
		self.battle_active = false
		self.game_over_sent = true
		self.battle_id = (self.battle_id or 0) + 1
		msg.post("main:/input_manager", "clear_prediction")
		msg.post("main:/input_manager", "set_target", { id = nil })
		clear_scene(self)
		unit_manager.active_unit_id = nil
		msg.post("/gui#game", "refresh_queue")

	-- 2. Юнит остановился -> Смена хода
	elseif message_id == hash("unit_stopped") then
		if not self.battle_active or self.game_over_sent then
			return
		end
		local current_battle = self.battle_id
		timer.delay(0.35, false, function()
			if self.battle_active and not self.game_over_sent and self.battle_id == current_battle then
				check_and_switch(self)
			end
		end)

	-- 3. Юнит умер
	elseif message_id == hash("unit_died") then
		if not self.battle_active or self.game_over_sent then
			return
		end

		local victim_id = message.id
		local killer_url = message.killer_id

		local ok, id = pcall(go.get, killer_url, "hero_id")
		if ok and id == 4 then
			msg.post(killer_url, "heal_reaper")
		end

		unit_manager.remove_unit(victim_id, message.team)
		msg.post("/gui#game", "refresh_queue")

		local current_battle = self.battle_id
		timer.delay(0.2, false, function()
			if self.battle_active and not self.game_over_sent and self.battle_id == current_battle then
				if unit_manager.is_everyone_stopped() then
					check_game_over(self)
				end
			end
		end)
	end
	if message_id == hash("trigger_wave") then
		local wave_pos = message.pos
		local radius = message.radius -- Радиус поражения волны
		print("rad".. radius)
		local force_mult = message.force -- Базовая сила из абилки (ability_value)
		local owner_id = message.owner_id


		-- Перебираем всех юнитов через наш менеджер
		for target_id, _ in pairs(unit_manager.all_units) do
			-- Не бьем сами себя
			if target_id ~= owner_id then
				local target_pos = go.get_world_position(target_id)
				local dist = vmath.length(target_pos - wave_pos)

				if dist < radius then
					-- Расчет направления отталкивания
					local dir = vmath.normalize(target_pos - wave_pos)
					-- Чем дальше юнит, тем слабее толчок (затухание)
					local falloff = (radius - dist) / radius
					local final_impulse = dir * force_mult * falloff * 5000

					-- Применяем физический импульс
					msg.post(msg.url(nil, target_id, "collisionobject"), "apply_impulse", {
						position = target_pos,
						impulse = final_impulse
					})

					-- Наносим урон (из ability_value)
					msg.post(target_id, "take_damage", { 
						amount = force_mult, 
						attacker_id = owner_id 
					})
				end
			end
		end
		-- Здесь можно спавнить визуальный эффект кольца/волны
	end
	if message_id == hash("trigger_explosion") then
		local exp_pos = message.pos
		local radius = message.radius or 160
		local damage = message.damage or 50
		local owner_id = message.owner_id

		-- Спавн визуального взрыва через фабрику
		pcall(factory.create, "#explosion_factory", exp_pos)

		-- Сочный звук взрыва и сотрясение экрана
		sound.play_hit(1.6)
		pcall(rendercam.shake, 16, 0.35)

		for target_id, _ in pairs(unit_manager.all_units) do
			if target_id ~= owner_id and go.exists(target_id) then
				local target_pos = go.get_world_position(target_id)
				local dist = vmath.length(target_pos - exp_pos)

				if dist < radius then
					local dir = dist > 1 and vmath.normalize(target_pos - exp_pos) or vmath.vector3(0, 1, 0)
					local falloff = (radius - dist) / radius
					local impulse_force = dir * damage * falloff * 4000

					pcall(msg.post, msg.url(nil, target_id, "collisionobject"), "apply_impulse", {
						position = target_pos,
						impulse = impulse_force
					})

					pcall(msg.post, target_id, "take_damage", {
						amount = math.max(1, math.floor(damage * falloff + 0.5)),
						attacker_id = owner_id
					})
				end
			end
		end
	end
end