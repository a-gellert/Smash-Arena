-- main/game_manager.script
local unit_manager = require "main.unit_manager"
local state = require "main.state"

-- Приватная функция для ИИ внутри менеджера
local function perform_ai_turn(self, ai_unit_id)
	print("ИИ обдумывает ход для: " .. tostring(ai_unit_id))

	local player_units = unit_manager.teams[1]
	if #player_units == 0 then return end

	-- Выбираем цель и считаем вектор
	local target_unit_id = player_units[math.random(1, #player_units)]

	-- Проверка на существование объектов перед расчетом
	if not go.exists(ai_unit_id) or not go.exists(target_unit_id) then return end

	local ai_pos = go.get_world_position(ai_unit_id)
	local target_pos = go.get_world_position(target_unit_id)
	local direction = target_pos - ai_pos

	if vmath.length(direction) > 0 then
		local impulse_vector = vmath.normalize(direction)

		timer.delay(1.2, false, function()
			print("ИИ стреляет!")
			msg.post(ai_unit_id, "apply_impulse", { vector = impulse_vector })
		end)
	end
end

local function activate_next_unit(self)
	local team_id = state.current_team
	local team = unit_manager.teams[team_id]

	-- Если в команде никого нет, пробуем сменить ход
	if #team == 0 then
		state.switch_turn()
		-- Если и во второй команде никого, значит игра окончена
		if #unit_manager.teams[state.current_team] == 0 then
			print("ВСЕ ЮНИТЫ УНИЧТОЖЕНЫ")
			return 
		end
		return activate_next_unit(self)
	end

	local idx = unit_manager.team_indices[team_id]
	if idx > #team then idx = 1 end -- Защита от выхода за границы после смерти юнита

	local next_unit = team[idx]

	if next_unit then
		print("--- ХОД КОМАНДЫ " .. team_id .. " (Юнит: " .. tostring(next_unit) .. ") ---")

		if team_id == 1 then
			-- Ход игрока
			msg.post("main:/input_manager", "set_target", { id = next_unit })
		else
			-- Ход ИИ
			msg.post("main:/input_manager", "set_target", { id = nil })
			perform_ai_turn(self, next_unit)
		end

		-- Обновляем индекс для следующего раза
		unit_manager.team_indices[team_id] = (idx % #team) + 1
	end
end

function init(self)
	math.randomseed(os.time())
	self.screen_w = sys.get_config_int("display.width", 390)
	self.screen_h = sys.get_config_int("display.height", 780)
end
local function check_and_switch(self)
	if unit_manager.is_everyone_stopped() then
		-- Все замерли, переключаем ход
		state.switch_turn()
		msg.post("/gui#game", "show_turn_msg", { team = state.current_team })
		activate_next_unit(self)
	else
		-- Кто-то еще катится, проверяем снова через 0.2 сек
		timer.delay(0.2, false, check_and_switch)
	end
end
function on_message(self, message_id, message, sender)
	-- 1. Создание битвы
	if message_id == hash("init_battle") then
		unit_manager.reset()

		local padding_x = self.screen_w / 6
		-- Позиции относительно центра, если коллекция центрирована, или абсолютные
		local player_y = -150
		local enemy_y = 150

		for i = 1, 4 do
			local p_id = factory.create("#unit_factory", vmath.vector3(padding_x * i - 128, player_y, 0), nil, { team_type = 1, hero_id = state.active_deck[i] })
			-- Регистрация происходит автоматически в unit.script через unit_manager.register_unit
		end

		for i = 1, 4 do
			factory.create("#unit_factory", vmath.vector3(padding_x * i -128, enemy_y, 0), nil, { team_type = 2, hero_id = state.active_deck[i]  })
		end
		
		timer.delay(0.25, false, function()
			print("Старт игры! Начинает команда: " .. state.current_team)
			msg.post("/gui#game", "show_turn_msg", { team = state.current_team })
			activate_next_unit(self)
		end)
	end

	-- 2. Юнит остановился -> Смена хода
	if message_id == hash("unit_stopped") then
		-- Когда ОДИН юнит замер, запускаем проверку ВСЕГО поля с небольшой задержкой
		timer.delay(0.5, false, check_and_switch)
	end

	-- 3. Юнит умер
	if message_id == hash("unit_died") then
		local victim_id = message.id
		local killer_id = message.killer_id -- Мы начали передавать это в take_damage

		-- Если убийца существует (это не смерть от стены или скрипта)
		if killer_id and go.exists(killer_id) then
			-- Проверяем, есть ли у убийцы умение Жнеца
			local killer_url = msg.url(nil, killer_id, "unit")
			local ability = go.get(killer_url, "ability_method")
			local heal_amount = go.get(killer_url, "ability_value")

			if ability == "life_steal_kill" then
				print("Жнец совершил убийство и восстанавливает силы!")
				msg.post(killer_id, "heal", { amount = heal_amount })

				-- Визуальный эффект Жатвы (красная вспышка на Жнеце)
				go.set(killer_url, "tint", vmath.vector4(1, 0, 0, 1))
				go.animate(killer_url, "tint", vmath.vector4(1, 1, 1, 1), gui.EASING_INOUTQUAD, 0.5)
			end
		end

		-- Стандартная логика удаления из очередей
		unit_manager.remove_unit(victim_id, message.team)
	end
	if message_id == hash("trigger_wave") then
		local wave_pos = message.pos
		local radius = 150 -- Радиус поражения волны
		local force_mult = message.force -- Базовая сила из абилки (ability_value)
		local owner_id = message.owner_id

		print("Танк выпускает волну!")

		-- Перебираем всех юнитов через наш менеджер
		for target_id, _ in pairs(unit_manager.all_units) do
			-- Не бьем сами себя
			if target_id ~= owner_id then
				local target_pos = go.get_world_position(target_id)
				local dist = vmath.length(target_pos - wave_pos)

				if dist < radius then
					-- Расчет направления отталкивания
					local dir = vmath.normalize(target_pos - wave_pos)
					-- Чем дальше юнит, тем слабее толчок (затухание)
					local falloff = (radius - dist) / radius
					local final_impulse = dir * force_mult * falloff * 5000

					-- Применяем физический импульс
					msg.post(msg.url(nil, target_id, "collisionobject"), "apply_impulse", {
						position = target_pos,
						impulse = final_impulse
					})

					-- Наносим урон (из ability_value)
					msg.post(target_id, "take_damage", { 
						amount = force_mult, 
						attacker_id = owner_id 
					})
				end
			end
		end
		-- Здесь можно спавнить визуальный эффект кольца/волны
	end
end