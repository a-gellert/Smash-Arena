-- unit_manager.script
local state = require "main.state"

-- Состояния менеджера
local teams = { [1] = {}, [2] = {} }
local team_indices = { [1] = 1, [2] = 1 } -- Храним индекс для каждой команды отдельно

-- В начало unit_manager.script
local function perform_ai_turn(self, ai_unit_id)
	print("ИИ обдумывает ход для: " .. ai_unit_id)

	-- 1. Находим все цели (юниты команды 1)
	local player_units = teams[1]
	if #player_units == 0 then return end

	-- 2. Выбираем случайную цель из команды игрока
	local target_unit_id = player_units[math.random(1, #player_units)]

	-- 3. Рассчитываем вектор от ИИ-юнита к цели
	local ai_pos = go.get_world_position(ai_unit_id)
	local target_pos = go.get_world_position(target_unit_id)
	local direction = target_pos - ai_pos

	-- 4. Нормализуем и добавляем силу
	if vmath.length(direction) > 0 then
		local impulse_vector = vmath.normalize(direction) * 50000 -- Та же сила, что у игрока

		-- Имитируем задержку "раздумий" перед ударом
		timer.delay(1.2, false, function()
			print("ИИ стреляет!")
			msg.post(ai_unit_id, "apply_impulse", { vector = impulse_vector })
		end)
	end
end
local function activate_next_unit(self)
	local team_id = state.current_team
	local team = teams[team_id]

	if #team == 0 then
		state.switch_turn()
		return activate_next_unit(self) -- Рекурсивно пробуем следующую команду
	end

	local idx = team_indices[team_id]
	local next_unit = team[idx]

	if next_unit then
		-- Если ходит игрок (Команда 1)
		if team_id == 1 then
			msg.post("/input_manager#input_manager", "set_target", { id = next_unit })
		else
			-- Если ходит ИИ (Команда 2)
			msg.post("/input_manager#input_manager", "set_target", { id = nil }) -- Блокируем ввод игрока
			perform_ai_turn(self, next_unit)
		end

		-- Обновляем индекс для команды
		team_indices[team_id] = (idx % #team) + 1
	end
end
function init(self)
	-- Инициализируем рандом (важно для Defold)
	math.randomseed(os.time())

	self.current_team = math.random(1, 2)
	state.current_team = self.current_team

	-- Даем 0.1 сек всем юнитам на регистрацию, прежде чем начать первый ход
	timer.delay(0.1, false, function()
		print("Старт игры! Начинает команда: " .. self.current_team)
		activate_next_unit(self)
	end)
end


function on_message(self, message_id, message, sender)
	if message_id == hash("register_unit") then
		table.insert(teams[message.team], sender)
		-- Запуск первого хода, когда зарегистрирован хотя бы один игрок
		--if #teams[1] == 1 and message.team == 1 then
		--	activate_next_unit(self)
		--end

		-- в unit_manager.script
	elseif message_id == hash("unit_stopped") then
		-- Блокируем любые действия на время паузы
		print("--- СИСТЕМА: Пауза симуляции ---")

		timer.delay(0.8, false, function()
			state.switch_turn() -- Сначала меняем ГЛОБАЛЬНЫЙ стейт
			self.current_team = state.current_team -- Синхронизируем локальный

			print("--- СИСТЕМА: Новый ход команды " .. self.current_team .. " ---")
			activate_next_unit(self)
		end)


	elseif message_id == hash("unit_died") then
		local team = teams[message.team]
		for i, id in ipairs(team) do
			if id == message.id then
				table.remove(team, i)
				print("Юнит удален из очереди. Осталось в команде: " .. #team)
				break
			end
		end
		-- Если команда пуста — Game Over
		if #team == 0 then
			print("Команда " .. message.team .. " проиграла!")
		end
	end
end