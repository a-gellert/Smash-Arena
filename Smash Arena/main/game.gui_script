-- game.gui_script
local state = require "main.state"
local poki = require "main.poki"
local data = require "main.heroes_data"
local unit_manager = require "main.unit_manager"
local chest_loot = require "main.chest_loot"
local sound = require "main.sound"

local LANG = "en"
local refresh_world_ui = nil

local function format_time(seconds)
	if seconds <= 0 then return "00:00:00" end
	local h = math.floor(seconds / 3600)
	local m = math.floor((seconds % 3600) / 60)
	local s = math.floor(seconds % 60)
	return string.format("%02d:%02d:%02d", h, m, s)
end

local function refresh_chests_ui(self)
	for i = 1, 4 do
		local chest_slot = state.chests[i]
		local template_node = gui.get_node("ch_template_" .. i)
		local status_label = gui.get_node("chest_status_" .. i)

		if not chest_slot or not chest_slot.id then
			gui.set_enabled(template_node, false)
		else
			gui.set_enabled(template_node, true)
			local config = data.chest_config[chest_slot.id]
			if config then
				gui.set_color(template_node, config.color)
			end

			if not chest_slot.is_opening then
				gui.set_text(status_label, "WAIT")
				gui.set_scale(status_label, vmath.vector3(0.5, 0.5, 1))
				gui.set_color(status_label, vmath.vector4(1, 0.9, 0.3, 1))
			end
		end
	end
end

local function set_tutorial_text(self, text_key)
	local label = gui.get_node("help_text")
	gui.set_text(label, state.STRINGS[text_key][LANG])

	-- "Сочное" появление текста
	gui.set_scale(label, vmath.vector3(0.8, 0.8, 1))
	gui.animate(label, "scale", vmath.vector3(1, 1, 1), gui.EASING_OUTBACK, 0.3)
end

local function show_finger_anim(self)
	local finger = gui.get_node("finger")
	gui.set_enabled(finger, true)

	-- Начальная позиция пальца (чуть выше центра или над героем)
	local start_pos = vmath.vector3(0, 50, 0)
	gui.set_position(finger, start_pos)

	-- Анимация: ведем вниз и повторяем
	gui.animate(finger, "position.y", start_pos.y - 150, gui.EASING_INOUTQUAD, 1.0, 0, nil, gui.PLAYBACK_LOOP_FORWARD)
end

local function refresh_active_deck_ui(self)
	for i = 1, 4 do
		local hero_id = state.active_deck[i]
		local level_label = gui.get_node("active_level_txt_" .. i)
		local icon_node = gui.get_node("active_icon_" .. i)
		local slot_node = gui.get_node("active_slot_" .. i)

		if hero_id then
			local hero_static = data.heroes[hero_id]
			local level = state.hero_levels[hero_id] or 1

			if hero_static then
				gui.set_text(level_label, "Lvl " .. level)
				local anim_id = hash(hero_static.name_key)
				gui.play_flipbook(icon_node, anim_id)
				gui.set_enabled(icon_node, true)
				gui.set_alpha(icon_node, 1.0)

				-- Подсветка рамки слота по редкости (если не в режиме выбора слота)
				if not self.is_waiting_for_swap then
					local rarity = hero_static.rarity or 1
					local color = vmath.vector4(0.5, 0.5, 0.5, 1)
					if rarity == 2 then color = vmath.vector4(0.2, 0.6, 1, 1) end
					if rarity == 3 then color = vmath.vector4(0.8, 0.3, 1, 1) end
					gui.set_color(slot_node, color)
				end
			end
		else
			gui.set_text(level_label, "")
			gui.set_alpha(icon_node, 0.2)
		end
	end
end

local function start_deck_swap_highlight(self)
	for i = 1, 4 do
		local slot_node = gui.get_node("active_slot_" .. i)
		gui.cancel_animation(slot_node, "scale")
		gui.cancel_animation(slot_node, "color")
		gui.set_scale(slot_node, vmath.vector3(1.0, 1.0, 1))
		-- Яркая золотисто-желтая подсветка рамки
		gui.set_color(slot_node, vmath.vector4(1.0, 0.88, 0.25, 1.0))
		-- Плавная пульсация, призывающая поставить бойца на один из слотов
		gui.animate(slot_node, "scale", vmath.vector3(1.1, 1.1, 1), gui.EASING_INOUTSINE, 0.45, 0, nil, gui.PLAYBACK_PINGPONG)
	end
end

local function stop_deck_swap_highlight(self)
	for i = 1, 4 do
		local slot_node = gui.get_node("active_slot_" .. i)
		gui.cancel_animation(slot_node, "scale")
		gui.cancel_animation(slot_node, "color")
		gui.set_scale(slot_node, vmath.vector3(1.0, 1.0, 1))
	end
	refresh_active_deck_ui(self)
end

local function refresh_text(self)
	local prestige_node = gui.get_node("prestige_txt")
	local gold_node     = gui.get_node("gold_txt")
	local almaz_node    = gui.get_node("almaz_txt")

	gui.set_text(prestige_node, tostring(state.prestige))
	gui.set_text(gold_node,     tostring(state.gold))
	gui.set_text(almaz_node,    tostring(state.almaz))

	if refresh_world_ui then
		refresh_world_ui(self)
	end
end

local function refresh_inventory_grid(self)
	for _, item in ipairs(self.all_cards_nodes) do
		local hero_id = item.hero_id
		local current_level = state.hero_levels[hero_id] or 1
		local player_cards = state.hero_cards[hero_id] or 0
		local stats = data.get_stats(hero_id, current_level)
		local cards_req = stats and stats.cards_required or 0

		if item.level_node then
			gui.set_text(item.level_node, "Lvl " .. current_level)
		end

		if item.count_node then
			if current_level >= data.MAX_LEVEL then
				gui.set_text(item.count_node, "MAX")
				gui.set_color(item.count_node, vmath.vector4(1, 0.85, 0.2, 1))
			else
				gui.set_text(item.count_node, player_cards .. "/" .. cards_req)
				if player_cards >= cards_req then
					gui.set_color(item.count_node, vmath.vector4(0.2, 1.0, 0.2, 1))
				else
					gui.set_color(item.count_node, vmath.vector4(1, 1, 1, 1))
				end
			end
		end
	end
end

local function update_info_panel(self, hero_id)
	self.selected_hero_id = hero_id
	local current_level = state.hero_levels[hero_id] or 1
	local player_cards = state.hero_cards[hero_id] or 0

	local stats = data.get_stats(hero_id, current_level)
	local next_stats = (current_level < data.MAX_LEVEL) and data.get_stats(hero_id, current_level + 1) or nil
	local can_up, gold_cost, cards_req = data.can_upgrade(hero_id, current_level, state.gold, player_cards)

	gui.set_text(gui.get_node("unit_level"), "Lvl " .. current_level)

	local fore_exp = gui.get_node("fore_exp_fill")
	local upgrade_cards_label = gui.get_node("upgrade_cards_label")
	local upgrade_price_label = gui.get_node("upgrade_price_label")
	local upgrade_btn = gui.get_node("upgrade_btn")

	if current_level >= data.MAX_LEVEL then
		gui.set_text(upgrade_cards_label, "MAX")
		gui.set_text(upgrade_price_label, "MAX")
		gui.set_scale(fore_exp, vmath.vector3(1, 1, 1))
		gui.set_color(upgrade_btn, vmath.vector4(0.4, 0.4, 0.4, 1))
	else
		gui.set_text(upgrade_cards_label, player_cards .. " / " .. cards_req)
		gui.set_text(upgrade_price_label, gold_cost .. " gold")

		local ratio = math.min(1.0, player_cards / math.max(1, cards_req))
		gui.set_scale(fore_exp, vmath.vector3(ratio, 1, 1))

		if can_up then
			gui.set_color(upgrade_btn, vmath.vector4(0.2, 0.9, 0.2, 1))
		else
			gui.set_color(upgrade_btn, vmath.vector4(0.5, 0.5, 0.5, 1))
		end
	end

	-- Показываем текущие статы и прибавку от следующего уровня
	if stats then
		if next_stats then
			local hp_bonus = next_stats.hp - stats.hp
			local dmg_bonus = next_stats.damage - stats.damage
			gui.set_text(gui.get_node("unit_hp_txt"), stats.hp .. " (+" .. hp_bonus .. ")")
			gui.set_text(gui.get_node("unit_damage_txt"), stats.damage .. " (+" .. dmg_bonus .. ")")
		else
			gui.set_text(gui.get_node("unit_hp_txt"), tostring(stats.hp))
			gui.set_text(gui.get_node("unit_damage_txt"), tostring(stats.damage))
		end
		gui.set_text(gui.get_node("unit_speed_txt"), string.format("%.1f", stats.speed or 1.0))
	end
end
-- Константы разметки инвентаря
local ITEM_SIZE = 80
local GRID_COLS = 4
local PADDING = 10

--------------------------
-- Утилитарные функции
--------------------------

local function hide_info_box(self)
	gui.set_enabled(gui.get_node("info_unit"), false)
end

-- Функция заполнения окна данными героя в бою
local function show_info_box(self, hero_id, current_hp, max_hp, level, is_dead)
	local window_w, window_h = window.get_size()
	local scale_val = 1
	if window_w > window_h then
		scale_val = 2
	end

	gui.set_scale(gui.get_node("info_unit"), vmath.vector3(scale_val, scale_val, 1))
	
	local hero_base = data.heroes[hero_id]
	local stats = data.get_stats(hero_id, level)

	local hero_name = data.get_name(hero_id, "en")
	if is_dead or (current_hp and current_hp <= 0) then
		hero_name = hero_name .. " (Dead)"
	end

	gui.set_text(gui.get_node("info_unit_name"), hero_name)
	gui.set_text(gui.get_node("info_unit_description"), data.get_description(hero_id, "en"))
	
	local display_hp = (is_dead or (current_hp and current_hp <= 0)) and 0 or (current_hp or 0)
	gui.set_text(gui.get_node("info_unit_hp_txt"), display_hp .. "/" .. (max_hp or 0))
	gui.set_text(gui.get_node("info_unit_damage_txt"), stats and tostring(stats.damage) or "0")
	gui.set_text(gui.get_node("info_unit_speed_txt"), stats and string.format("%.1f", stats.speed or 1.0) or "1.0")

	gui.set_enabled(gui.get_node("info_unit"), true)
	local icon_path = hero_base and hero_base.name_key or "paladin"
	gui.play_flipbook(gui.get_node("info_unit_icon"), hash(icon_path))
end

local function refresh_queue_panel(self)
	local active_slot = unit_manager.get_active_slot_index and unit_manager.get_active_slot_index() or nil
	for i = 1, 8 do
		local slot_data = unit_manager.get_slot_data(i)
		local icon_node = gui.get_node("unit_icon_" .. i)
		local ico_node = gui.get_node("ico_" .. i)

		if slot_data and slot_data.hero_id then
			local hero_static_data = data.heroes[slot_data.hero_id]
			if hero_static_data then
				local anim_id = hash(hero_static_data.name_key)
				gui.play_flipbook(ico_node, anim_id)
			end

			gui.set_enabled(icon_node, true)

			-- Если юнит погиб: затемняем иконку, но оставляем на своем месте кликабельной!
			if slot_data.is_dead or slot_data.hp <= 0 then
				gui.cancel_animation(icon_node, "scale")
				gui.set_scale(icon_node, vmath.vector3(1.0, 1.0, 1))
				gui.set_color(ico_node, vmath.vector4(0.3, 0.3, 0.3, 0.45))
				gui.set_color(icon_node, vmath.vector4(0.2, 0.1, 0.1, 0.5))
			else
				gui.set_color(ico_node, vmath.vector4(1, 1, 1, 1))
				if i == active_slot then
					-- Выделяем активного бойца в очереди: делаем крупнее и подсвечиваем яркой рамкой!
					gui.cancel_animation(icon_node, "scale")
					gui.set_scale(icon_node, vmath.vector3(1.12, 1.12, 1))
					-- Мягкая сочная пульсация во время активности
					gui.animate(icon_node, "scale", vmath.vector3(1.15, 1.15, 1), gui.EASING_INOUTSINE, 0.55, 0, nil, gui.PLAYBACK_PINGPONG)

					if i <= 4 then
						-- Карточка союзника: яркая золотисто-желтая рамка
						gui.set_color(icon_node, vmath.vector4(1.0, 0.9, 0.2, 1.0))
					else
						-- Карточка врага: огненно-красная рамка
						gui.set_color(icon_node, vmath.vector4(1.0, 0.28, 0.28, 1.0))
					end
				else
					gui.cancel_animation(icon_node, "scale")
					gui.set_scale(icon_node, vmath.vector3(1.0, 1.0, 1))
					gui.set_color(icon_node, vmath.vector4(0.5, 0.5, 0.5, 0.76))
				end
			end
		else
			gui.cancel_animation(icon_node, "scale")
			gui.set_scale(icon_node, vmath.vector3(1.0, 1.0, 1))
			gui.set_enabled(icon_node, false)
		end
	end
end
local function run_tutorial_logic(self)
	if state.tutorial_step == 1 then
		-- Показываем стрелку на кнопку "В БОЙ"
		gui.set_visible(self.tutorial_arrow, true)
		gui.set_position(self.tutorial_arrow, gui.get_position(self.btn_start_battle))
		gui.set_text(self.tutorial_label, "Это твоя команда. Пора в бой!")
	elseif state.tutorial_step == 4 then
		-- Подсказка на сундук в главном меню
		gui.set_visible(self.tutorial_arrow, true)
		gui.set_position(self.tutorial_arrow, gui.get_position(self.chest_node))
		gui.set_text(self.tutorial_label, "Смотри, ты заработал трофей!")
	end
end


local function show_screen(self, screen_name)
	local screens = { "main_menu", "lobby_screen", "main_game" }
	for _, name in ipairs(screens) do
		gui.set_enabled(gui.get_node(name), name == screen_name)
	end
	if screen_name == "main_game" then
		sound.stop_music()
	elseif screen_name == "main_menu" or screen_name == "lobby_screen" then
		sound.play_music()
	end
end

-- Управление ползунками настроек (SOUND / MUSIC)
local function set_sfx_slider_ui(self, ratio)
	ratio = math.max(0, math.min(1, ratio))
	local bar_width = 200
	gui.set_size(gui.get_node("sfx_bar_fill"), vmath.vector3(bar_width * ratio, 12, 0))
	gui.set_position(gui.get_node("sfx_pin"), vmath.vector3(-100 + bar_width * ratio, 0, 0))
	local pct = math.floor(ratio * 100 + 0.5)
	if pct == 0 then
		gui.set_text(gui.get_node("sfx_label"), "SOUND: OFF")
	else
		gui.set_text(gui.get_node("sfx_label"), string.format("SOUND: %d%%", pct))
	end
end

local function set_music_slider_ui(self, ratio)
	ratio = math.max(0, math.min(1, ratio))
	local bar_width = 200
	gui.set_size(gui.get_node("music_bar_fill"), vmath.vector3(bar_width * ratio, 12, 0))
	gui.set_position(gui.get_node("music_pin"), vmath.vector3(-100 + bar_width * ratio, 0, 0))
	local pct = math.floor(ratio * 100 + 0.5)
	if pct == 0 then
		gui.set_text(gui.get_node("music_label"), "MUSIC: OFF")
	else
		gui.set_text(gui.get_node("music_label"), string.format("MUSIC: %d%%", pct))
	end
end

local function refresh_settings_ui(self)
	set_sfx_slider_ui(self, (state.sfx_volume ~= nil) and state.sfx_volume or 1.0)
	set_music_slider_ui(self, (state.music_volume ~= nil) and state.music_volume or 0.8)
end

local function update_slider_by_screen_x(self, slider_name, screen_x)
	local anchor_l = gui.get_node(slider_name .. "_anchor_l")
	local anchor_r = gui.get_node(slider_name .. "_anchor_r")
	local left_x = gui.get_screen_position(anchor_l).x
	local right_x = gui.get_screen_position(anchor_r).x

	local ratio = 0
	if math.abs(right_x - left_x) > 0.001 then
		ratio = (screen_x - left_x) / (right_x - left_x)
	end
	ratio = math.max(0, math.min(1, ratio))

	if slider_name == "sfx" then
		state.sfx_volume = ratio
		sound.set_sfx_volume(ratio)
		set_sfx_slider_ui(self, ratio)
	elseif slider_name == "music" then
		state.music_volume = ratio
		sound.set_music_volume(ratio)
		set_music_slider_ui(self, ratio)
	end
end

refresh_world_ui = function(self)
	self.preview_world = self.preview_world or state.selected_world or 1
	if self.preview_world < 1 then self.preview_world = 1 end
	if self.preview_world > #state.WORLDS then self.preview_world = #state.WORLDS end

	local w = state.WORLDS[self.preview_world]
	if not w then return end

	local is_unlocked = state.is_world_unlocked(self.preview_world)
	local is_active = (self.preview_world == state.selected_world)

	-- Номер арены и название
	gui.set_text(gui.get_node("world_num_txt"), "ARENA " .. w.id)
	gui.set_text(gui.get_node("world_title_txt"), (LANG == "ru") and w.name_ru or w.name_en)

	-- Превью арены
	local preview_node = gui.get_node("world_preview_img")
	if preview_node then
		gui.play_flipbook(preview_node, "preview_arena_" .. self.preview_world)
		if is_unlocked then
			gui.set_color(preview_node, vmath.vector4(1, 1, 1, 1))
		else
			gui.set_color(preview_node, vmath.vector4(0.35, 0.35, 0.4, 0.85))
		end
	end

	-- Описание или требование престижа
	local desc_node = gui.get_node("world_desc_txt")
	if not is_unlocked then
		local current_p = state.prestige or 0
		if LANG == "ru" then
			gui.set_text(desc_node, string.format("Нужно %d престижа (у вас: %d)", w.required_prestige, current_p))
		else
			gui.set_text(desc_node, string.format("Requires %d Prestige (have: %d)", w.required_prestige, current_p))
		end
		gui.set_color(desc_node, vmath.vector4(1.0, 0.45, 0.45, 1.0))
	else
		gui.set_text(desc_node, (LANG == "ru") and w.description_ru or w.description_en)
		gui.set_color(desc_node, vmath.vector4(0.8, 0.85, 0.95, 1.0))
	end

	-- Цвет рамки карточки под тему мира
	local border = w.border_color or vmath.vector4(1, 1, 1, 1)
	if not is_unlocked then
		gui.set_color(gui.get_node("world_card"), vmath.vector4(0.35, 0.35, 0.4, 1.0))
	else
		gui.set_color(gui.get_node("world_card"), border)
	end

	-- Кнопка статуса
	local status_btn = gui.get_node("world_status_btn")
	local status_txt = gui.get_node("world_status_txt")
	if not is_unlocked then
		gui.set_text(status_txt, (LANG == "ru") and "ЗАКРЫТО" or "LOCKED")
		gui.set_color(status_btn, vmath.vector4(0.3, 0.3, 0.35, 1.0))
		gui.play_flipbook(status_btn, "btn_red")
	elseif is_active then
		gui.set_text(status_txt, (LANG == "ru") and "ВЫБРАНО" or "ACTIVE")
		gui.set_color(status_btn, vmath.vector4(0.2, 0.75, 0.3, 1.0))
		gui.play_flipbook(status_btn, "btn_blue")
	else
		gui.set_text(status_txt, (LANG == "ru") and "ВЫБРАТЬ" or "SELECT")
		gui.set_color(status_btn, vmath.vector4(0.95, 0.65, 0.15, 1.0))
		gui.play_flipbook(status_btn, "btn_orange")
	end

	-- Стрелки переключения: всегда активны и полностью видны
	gui.set_alpha(gui.get_node("btn_world_prev"), 1.0)
	gui.set_alpha(gui.get_node("btn_world_next"), 1.0)
end

local function show_tab(self, tab_name)
	if self.active_slider then
		self.active_slider = nil
		state.save()
	end
	if tab_name ~= "tab_inventory" and self.is_waiting_for_swap then
		self.is_waiting_for_swap = false
		stop_deck_swap_highlight(self)
		gui.set_enabled(gui.get_node("choose_txt"), false)
	end
	local tabs = { "tab_play", "tab_inventory", "tab_settings" }
	for _, name in ipairs(tabs) do
		gui.set_enabled(gui.get_node(name), name == tab_name)
	end
	if tab_name == "tab_settings" then
		refresh_settings_ui(self)
	elseif tab_name == "tab_play" then
		refresh_world_ui(self)
	end
end

-- Обновление информации о герое в Info Box
local function update_info_box(self, hero_id)
	local hero = data.heroes[hero_id]
	local level = state.hero_levels[hero_id] or 1
	local stats = data.get_stats(hero_id, level)
	local window_w, window_h = window.get_size()
	local scale_val = 1 -- По умолчанию портрет
	local y =180

	if window_w > window_h then
		scale_val = 1.5 -- Ландшафт
		y= 100
	end

	gui.set_scale(gui.get_node("info_box"), vmath.vector3(scale_val, scale_val, 1))
	gui.set_position(gui.get_node("info_box"), vmath.vector3(0, y, 1))
	gui.set_text(gui.get_node("unit_name"), data.strings[hero.name_key].en)

	-- Заменяем плейсхолдер ability_value на реальное число
	local desc = data.strings[hero.desc_key].en:gsub("ability_value", tostring(hero.ability_value))
	gui.set_text(gui.get_node("unit_description"), desc)

	gui.set_text(gui.get_node("unit_hp_txt"),  stats.hp)
	gui.set_text(gui.get_node("unit_damage_txt"),  stats.damage)
	gui.set_text(gui.get_node("unit_speed_txt"),  string.format("%.1f", stats.speed))
	
	local hero_data = data.heroes[hero_id]
	-- Собираем путь к кадру. ВАЖНО: hash() применяется ко ВСЕЙ строке пути, а не к её части.
	local icon_path = hero_data.name_key 
	gui.play_flipbook(gui.get_node("unit_icon"), hash(icon_path))
	--gui.play_flipbook(gui.get_node("unit_icon"),frame_name)
	-- Показываем Info Box, если он был скрыт
	gui.set_enabled(gui.get_node("info_box"), true)
end

-- Обновление иконок активной колоды
local function refresh_active_deck(self)
	for i = 1, 4 do
		local hero_id = player.active_squad[i]
		local slot_node = gui.get_node("active_slot_" .. i)
		-- Здесь можно менять текстуру/цвет в зависимости от героя
		-- Пока просто красим в цвет редкости (заглушка)
		local rarity = data.heroes[hero_id].rarity
		local color = vmath.vector4(0.5, 0.5, 0.5, 1) -- По умолчанию
		if rarity == 2 then color = vmath.vector4(0.2, 0.6, 1, 1) end
		if rarity == 3 then color = vmath.vector4(0.7, 0.2, 1, 1) end
		gui.set_color(slot_node, color)
	end
end

-- Вспомогательная функция для заполнения слота в лобби
local function fill_lobby_slot(self, index, hero_id, level, animate)
	local icon_node = gui.get_node("lobby_unit_" .. index)
	local level_node = gui.get_node("lobby_level_" .. index)

	if hero_id then
		local hero_static = data.heroes[hero_id]

		-- Устанавливаем иконку и уровень
		gui.play_flipbook(icon_node, hash(hero_static.name_key))
		gui.set_text(level_node, level)

		gui.set_enabled(icon_node, true)
		gui.set_enabled(level_node, true)

		if animate then
			-- Начальное состояние для анимации (невидим и мал)
			gui.set_scale(icon_node, vmath.vector3(0.5, 0.5, 1))
			gui.set_alpha(icon_node, 0)
			gui.set_alpha(level_node, 0)

			-- Анимация появления (эффект "pop-in")
			gui.animate(icon_node, "scale", vmath.vector3(1, 1, 1), gui.EASING_OUTBACK, 0.4)
			gui.animate(icon_node, "color.w", 1, gui.EASING_INQUAD, 0.3)
			gui.animate(level_node, "color.w", 1, gui.EASING_INQUAD, 0.3)
		else
			-- Для игрока просто показываем сразу
			gui.set_scale(icon_node, vmath.vector3(1, 1, 1))
			gui.set_alpha(icon_node, 1)
			gui.set_alpha(level_node, 1)
		end
	else
		gui.set_enabled(icon_node, false)
		gui.set_enabled(level_node, false)
	end
end
local function animate_money(self, node, start_value, end_value, duration)
	-- 1. Фаза начисления (бегущие цифры)
	local data = { val = start_value }

	-- Анимируем виртуальное свойство в таблице
	gui.animate(data, "val", end_value, gui.EASING_LINEAR, duration, 0, function()
		-- 2. Фаза прыжка (когда цифры добежали)
		gui.set_scale(node, vmath.vector3(1, 1, 1)) -- Сброс на всякий случай

		-- Сначала увеличиваем (подпрыгивает)
		gui.animate(node, gui.PROP_SCALE, vmath.vector3(1.2, 1.2, 1), gui.EASING_OUTBACK, 0.2, 0, function()
			-- Потом возвращаем в норму
			gui.animate(node, gui.PROP_SCALE, vmath.vector3(1, 1, 1), gui.EASING_OUTSINE, 0.1)
		end)
	end)

	-- Чтобы текст обновлялся, пока идет анимация 'data.val'
	-- Мы используем таймер или update, но проще всего запустить отдельный цикл обновления
	local current_step = 0
	local steps = duration / 0.02 -- Примерное кол-во кадров

	local function update_text()
		if data.val then
			-- Форматируем число (делаем целым)
			gui.set_text(node, string.format("%d", math.floor(data.val)))

			if data.val < end_value then
				timer.delay(0.02, false, update_text)
			else
				gui.set_text(node, tostring(end_value)) -- Финальное точное значение
			end
		end
	end

	update_text()
end
local function start_lobby_search(self)
	-- 1. ГЕНЕРАЦИЯ ВРАГА (делаем это сразу при нажатии "В Бой")
	state.enemy_deck = {}
	state.enemy_levels = {}

	-- Создаем список всех доступных ID героев из heroes_data
	local pool = {}
	for i = 1, #data.heroes do table.insert(pool, i) end

	for i = 1, 4 do
		-- Выбираем случайного уникального героя из пула
		local rand_idx = math.random(1, #pool)
		local enemy_hero_id = table.remove(pool, rand_idx)

		state.enemy_deck[i] = enemy_hero_id

		-- Логика "Чуть слабее": 
		-- Берем уровень игрока в этом же слоте i
		local player_hero_id = state.active_deck[i]
		local player_lvl = state.hero_levels[player_hero_id] or 1

		-- Вычитаем 0 или 1 (шанс 50/50 что будет слабее)
		local enemy_lvl = math.max(1, player_lvl - math.random(0, 1))
		state.enemy_levels[enemy_hero_id] = enemy_lvl
	end

	-- 2. ПОДГОТОВКА ЭКРАНА ЛОББИ
	show_screen(self, "lobby_screen")

	-- Заполняем бойцов игрока (слоты 1-4)
	for i = 1, 4 do
		local h_id = state.active_deck[i]
		local h_lvl = state.hero_levels[h_id] or 1
		fill_lobby_slot(self, i, h_id, h_lvl, false)
	end

	-- Прячем вражеские слоты (5-8)
	for i = 5, 8 do
		gui.set_enabled(gui.get_node("lobby_unit_" .. i), false)
		gui.set_enabled(gui.get_node("lobby_level_" .. i), false)
	end

	-- 3. ТАЙМЕРЫ ПОИСКА
	local search_time = 2.5 + math.random() * 1.5

	-- Показываем врага через половину времени
	timer.delay(search_time / 3, false, function()
		for i = 1, 4 do
			local e_id = state.enemy_deck[i]
			local e_lvl = state.enemy_levels[e_id]
			fill_lobby_slot(self, i + 4, e_id, e_lvl, true)
		end
		-- Можно добавить эффект тряски экрана при нахождении
	end)

	-- Переход в игру
	timer.delay(search_time, false, function()
		show_screen(self, "main_game")

		pcall(msg.post, "/arena/arena_loader#script", "change_world", { world_id = state.selected_world or 1 })
		poki.gameplay_start("arena", 1)
		poki.round_start(1)
		msg.post("main:/game_manager", "init_battle")
	end)

	timer.delay(search_time + 0.1, false, function() refresh_queue_panel(self) end)
end
--------------------------
-- Жизненный цикл
--------------------------
local function init_inventory(self)
	local parent = gui.get_node("all_cards")
	local template_node = gui.get_node("unit_card_template")
	gui.set_enabled(template_node, false)

	self.all_cards_nodes = {}

	for i = 1, #data.heroes do
		local hero = data.heroes[i]
		local nodes = gui.clone_tree(template_node)

		-- ВНИМАНИЕ: Проверь эти ID в окне Outline в Defold!
		-- Если нода называется "level", то пиши hash("level")
		local root = nodes[hash("unit_card_template")]
		local icon = nodes[hash("unit_card_icon")]
		local level_txt = nodes[hash("unit_level")]
		local count_txt = nodes[hash("unit_card_count_template")]

		-- Отладка: если падает, раскомментируй строку ниже и посмотри в консоль
		-- pprint(nodes) 

		if root then
			gui.set_parent(root, parent)
			gui.set_enabled(root, true)

			-- Безопасная установка иконки
			if icon then
				local icon_path = hero.name_key 
				gui.play_flipbook(icon, hash(icon_path))
			else
				print("ОШИБКА: Нода иконки не найдена! Проверь ID.")
			end

			-- Безопасная установка уровня
			if level_txt then
				local level = state.hero_levels[hero.id] or 1
				gui.set_text(level_txt, level)
			else
				-- Если ты здесь, значит в хеше ошибка
				print("ОШИБКА: Нода уровня не найдена. Ищу: unit_card_level_template")
			end

			-- Позиционирование
			local row = math.floor((i - 1) / GRID_COLS)

			local col = (i - 1) % GRID_COLS

			local pos = vmath.vector3(col * (ITEM_SIZE + PADDING) - 135, -row * (ITEM_SIZE + PADDING) + 135, 0)

			gui.set_position(root, pos)
			table.insert(self.all_cards_nodes, { 
				hero_id = hero.id, 
				root = root,
				level_node = level_txt,
				count_node = count_txt,
				icon_node = icon
			})
		end
	end
end

local function spawn_flying_currency(self, currency_type, count, start_pos, target_pos, target_node, on_complete)
	local completed = 0
	local total = count or 6
	for i = 1, total do
		local node = gui.new_box_node(start_pos, vmath.vector3(38, 38, 0))
		gui.set_texture(node, "gui")
		gui.play_flipbook(node, currency_type)
		gui.set_parent(node, gui.get_node("main_menu"))
		gui.set_scale(node, vmath.vector3(0.1, 0.1, 1))

		local angle = (i / total) * math.pi * 2 + (math.random() - 0.5) * 0.5
		local burst_dist = math.random(40, 85)
		local burst_pos = vmath.vector3(start_pos.x + math.cos(angle) * burst_dist, start_pos.y + math.sin(angle) * burst_dist, 0)
		local delay = (i - 1) * 0.04

		gui.animate(node, "scale", vmath.vector3(1.15, 1.15, 1), gui.EASING_OUTBACK, 0.2, delay)
		gui.animate(node, "position", burst_pos, gui.EASING_OUTQUAD, 0.2, delay, function()
			gui.animate(node, "position.x", target_pos.x, gui.EASING_INQUAD, 0.35)
			gui.animate(node, "position.y", target_pos.y, gui.EASING_OUTQUAD, 0.35, 0, function()
				gui.delete_node(node)
				completed = completed + 1
				if target_node then
					gui.set_scale(target_node, vmath.vector3(1.2, 1.2, 1))
					gui.animate(target_node, "scale", vmath.vector3(1.0, 1.0, 1), gui.EASING_OUTBACK, 0.15)
				end
				if completed == total and on_complete then
					on_complete()
				end
			end)
			gui.animate(node, "scale", vmath.vector3(0.5, 0.5, 1), gui.EASING_INQUAD, 0.35)
		end)
	end
end

local function set_modal_title(title_node, text, color)
	gui.set_text(title_node, text or "")
	if color then
		gui.set_color(title_node, color)
	end
	local len = string.len(text or "")
	if len > 20 then
		gui.set_scale(title_node, vmath.vector3(0.58, 0.58, 1))
	elseif len > 14 then
		gui.set_scale(title_node, vmath.vector3(0.66, 0.66, 1))
	else
		gui.set_scale(title_node, vmath.vector3(0.72, 0.72, 1))
	end
end

local function render_current_reward_step(self)
	local step = self.reward_steps[self.reward_step_index]
	if not step then return end

	local panel = gui.get_node("end_screen_panel1")
	local title = gui.get_node("end_screen_title1")
	local chest_icon = gui.get_node("chest_icon1")
	local gold_award = gui.get_node("gold_award1")
	local almaz_award = gui.get_node("exp_award1")
	local cards_txt = gui.get_node("cards_award_txt1")
	local cancel_btn = gui.get_node("cancel_modal_btn1")
	local action_btn_txt = gui.get_node("text7")

	gui.set_enabled(cancel_btn, false)
	gui.set_enabled(panel, true)

	if step.type == "chest_pop" then
		gui.set_texture(chest_icon, "gui")
		gui.play_flipbook(chest_icon, "chest")
		gui.set_size(chest_icon, vmath.vector3(140, 140, 0))
		gui.set_scale(chest_icon, vmath.vector3(0.5, 0.5, 1))
		gui.animate(chest_icon, "scale", vmath.vector3(1.25, 1.25, 1), gui.EASING_OUTBACK, 0.35, 0, function()
			gui.animate(chest_icon, "scale", vmath.vector3(1.0, 1.0, 1), gui.EASING_INOUTQUAD, 0.2)
		end)

		set_modal_title(title, step.chest_name or "CHEST UNLOCKED", step.chest_color or vmath.vector4(1, 0.85, 0.2, 1))
		gui.set_enabled(gold_award, false)
		gui.set_enabled(almaz_award, false)
		gui.set_text(cards_txt, "Tap to open rewards!")
		gui.set_text(action_btn_txt, "OPEN")

	elseif step.type == "gold" then
		gui.set_texture(chest_icon, "gui")
		gui.play_flipbook(chest_icon, "coin")
		gui.set_size(chest_icon, vmath.vector3(130, 130, 0))
		gui.set_scale(chest_icon, vmath.vector3(0.2, 0.2, 1))
		gui.animate(chest_icon, "scale", vmath.vector3(1.3, 1.3, 1), gui.EASING_OUTBACK, 0.3, 0, function()
			gui.animate(chest_icon, "scale", vmath.vector3(1.0, 1.0, 1), gui.EASING_INOUTQUAD, 0.15)
		end)

		set_modal_title(title, "GOLD REWARD", vmath.vector4(1, 0.85, 0.2, 1))
		gui.set_enabled(gold_award, false)
		gui.set_enabled(almaz_award, false)
		gui.set_text(cards_txt, "+" .. tostring(step.amount) .. " Gold")
		gui.set_text(action_btn_txt, "CONTINUE")

		-- Flying coins to header
		spawn_flying_currency(self, "coin", 8, vmath.vector3(0, 0, 0), vmath.vector3(0, 350, 0), gui.get_node("gold_block"), function()
			refresh_text(self)
		end)

	elseif step.type == "diamonds" then
		gui.set_texture(chest_icon, "gui")
		gui.play_flipbook(chest_icon, "almaz")
		gui.set_size(chest_icon, vmath.vector3(130, 130, 0))
		gui.set_scale(chest_icon, vmath.vector3(0.2, 0.2, 1))
		gui.animate(chest_icon, "scale", vmath.vector3(1.3, 1.3, 1), gui.EASING_OUTBACK, 0.3, 0, function()
			gui.animate(chest_icon, "scale", vmath.vector3(1.0, 1.0, 1), gui.EASING_INOUTQUAD, 0.15)
		end)

		set_modal_title(title, "GEMS REWARD", vmath.vector4(0.2, 1.0, 0.4, 1))
		gui.set_enabled(gold_award, false)
		gui.set_enabled(almaz_award, false)
		gui.set_text(cards_txt, "+" .. tostring(step.amount) .. " Diamonds!")
		gui.set_text(action_btn_txt, "CONTINUE")

		-- Flying gems to header
		spawn_flying_currency(self, "almaz", 6, vmath.vector3(0, 0, 0), vmath.vector3(128, 350, 0), gui.get_node("almaz_block"), function()
			refresh_text(self)
		end)

	elseif step.type == "card" then
		gui.set_texture(chest_icon, "units")
		gui.play_flipbook(chest_icon, step.icon or "paladin")
		gui.set_size(chest_icon, vmath.vector3(140, 140, 0))

		-- 3D flip card animation
		gui.set_scale(chest_icon, vmath.vector3(0.01, 1.3, 1))
		gui.animate(chest_icon, "scale.x", 1.0, gui.EASING_OUTBACK, 0.35)
		gui.animate(chest_icon, "scale.y", 1.0, gui.EASING_OUTBACK, 0.35)

		local rarity_color = vmath.vector4(0.3, 0.8, 1.0, 1)
		if step.rarity == 3 then
			rarity_color = vmath.vector4(0.85, 0.3, 1.0, 1)
		elseif step.rarity == 2 then
			rarity_color = vmath.vector4(1.0, 0.65, 0.1, 1)
		end

		set_modal_title(title, step.name, rarity_color)
		gui.set_enabled(gold_award, false)
		gui.set_enabled(almaz_award, false)

		local curr_cards = state.hero_cards[step.hero_id] or 0
		local lvl = state.hero_levels[step.hero_id] or 1
		gui.set_text(cards_txt, "+" .. tostring(step.amount) .. " Cards! (" .. curr_cards .. " Total)\nLevel " .. lvl)
		gui.set_text(action_btn_txt, "CONTINUE")

	elseif step.type == "summary" then
		gui.set_texture(chest_icon, "gui")
		gui.play_flipbook(chest_icon, "chest")
		gui.set_size(chest_icon, vmath.vector3(100, 100, 0))
		gui.set_scale(chest_icon, vmath.vector3(1.0, 1.0, 1))

		set_modal_title(title, "ALL REWARDS COLLECTED!", vmath.vector4(1, 0.85, 0.2, 1))

		if step.rewards.gold and step.rewards.gold > 0 then
			gui.set_enabled(gold_award, true)
			gui.set_text(gui.get_node("gold_award_txt1"), "+" .. tostring(step.rewards.gold))
		else
			gui.set_enabled(gold_award, false)
		end

		if step.rewards.diamonds and step.rewards.diamonds > 0 then
			gui.set_enabled(almaz_award, true)
			gui.set_text(gui.get_node("exp_award_txt1"), "+" .. tostring(step.rewards.diamonds))
		else
			gui.set_enabled(almaz_award, false)
		end

		local card_lines = {}
		if step.rewards.cards and #step.rewards.cards > 0 then
			for _, c in ipairs(step.rewards.cards) do
				table.insert(card_lines, "+" .. c.amount .. " " .. c.name)
			end
		end
		local cards_str = #card_lines > 0 and table.concat(card_lines, "\n") or "All rewards added to inventory"
		gui.set_text(cards_txt, cards_str)
		gui.set_text(action_btn_txt, "CLAIM")
	end
end

local function start_chest_reward_sequence(self, rewards)
	self.modal_mode = "reward_sequence"
	self.modal_chest_index = nil
	self.modal_speedup_cost = 0

	self.reward_steps = {}

	-- Step 1: Chest burst
	table.insert(self.reward_steps, {
		type = "chest_pop",
		chest_id = rewards.chest_id,
		chest_name = rewards.chest_name,
		chest_color = rewards.chest_color
	})

	-- Step 2: Gold
	if rewards.gold and rewards.gold > 0 then
		table.insert(self.reward_steps, {
			type = "gold",
			amount = rewards.gold
		})
	end

	-- Step 3: Diamonds
	if rewards.diamonds and rewards.diamonds > 0 then
		table.insert(self.reward_steps, {
			type = "diamonds",
			amount = rewards.diamonds
		})
	end

	-- Step 4..N: Cards
	if rewards.cards and #rewards.cards > 0 then
		for _, card in ipairs(rewards.cards) do
			table.insert(self.reward_steps, {
				type = "card",
				hero_id = card.hero_id,
				name = card.name,
				amount = card.amount,
				icon = card.icon,
				rarity = card.rarity
			})
		end
	end

	-- Final Step: Summary
	table.insert(self.reward_steps, {
		type = "summary",
		rewards = rewards
	})

	self.reward_step_index = 1

	local panel = gui.get_node("end_screen_panel1")
	gui.set_enabled(panel, true)
	gui.set_scale(gui.get_node("end_screen1"), vmath.vector3(0.8, 0.8, 1))
	gui.animate(gui.get_node("end_screen1"), "scale", vmath.vector3(1, 1, 1), gui.EASING_OUTBACK, 0.3)

	render_current_reward_step(self)
end

local function advance_reward_step(self)
	if not self.reward_steps or #self.reward_steps == 0 then
		gui.set_enabled(gui.get_node("end_screen_panel1"), false)
		self.modal_mode = nil
		return
	end

	if self.reward_step_index < #self.reward_steps then
		self.reward_step_index = self.reward_step_index + 1
		render_current_reward_step(self)
	else
		-- Final claim & close
		gui.set_enabled(gui.get_node("end_screen_panel1"), false)
		self.modal_mode = nil
		self.reward_steps = nil
		self.reward_step_index = 1
		refresh_text(self)
		refresh_inventory_grid(self)
		refresh_active_deck_ui(self)
	end
end

local function show_speedup_modal(self, chest_index)
	local ch = state.chests[chest_index]
	if not ch or not ch.id then return end

	local cfg = data.chest_config[ch.id]
	local elapsed = ch.is_opening and (os.time() - ch.unlock_start_time) or 0
	local remaining = math.max(0, cfg.time - elapsed)
	local cost = chest_loot.get_speedup_cost(remaining)

	self.modal_mode = "speedup"
	self.modal_chest_index = chest_index
	self.modal_speedup_cost = cost

	local panel = gui.get_node("end_screen_panel1")
	local title = gui.get_node("end_screen_title1")
	local chest_icon = gui.get_node("chest_icon1")
	local gold_award = gui.get_node("gold_award1")
	local almaz_award = gui.get_node("exp_award1")
	local almaz_txt = gui.get_node("exp_award_txt1")
	local cards_txt = gui.get_node("cards_award_txt1")
	local cancel_btn = gui.get_node("cancel_modal_btn1")
	local action_btn_txt = gui.get_node("text7")

	gui.set_texture(chest_icon, "gui")
	gui.play_flipbook(chest_icon, "chest")
	gui.set_size(chest_icon, vmath.vector3(120, 120, 0))
	gui.set_scale(chest_icon, vmath.vector3(1.0, 1.0, 1))

	set_modal_title(title, "Unlock Instantly?", vmath.vector4(1, 0.9, 0.3, 1))

	gui.set_enabled(gold_award, false)
	gui.set_enabled(almaz_award, true)
	gui.set_text(almaz_txt, cost .. " Gems")

	local info_msg = "Open " .. cfg.name .. " immediately?"
	if remaining > 0 then
		info_msg = info_msg .. "\nTime left: " .. format_time(remaining)
	end
	gui.set_text(cards_txt, info_msg)
	gui.set_enabled(cards_txt, true)

	gui.set_enabled(cancel_btn, true)
	gui.set_text(action_btn_txt, "OPEN (" .. cost .. ")")

	gui.set_enabled(panel, true)
	gui.set_scale(gui.get_node("end_screen1"), vmath.vector3(0.8, 0.8, 1))
	gui.animate(gui.get_node("end_screen1"), "scale", vmath.vector3(1, 1, 1), gui.EASING_OUTBACK, 0.3)
end

local function open_chest(self, index)
	local ch = state.chests[index]
	if not ch or not ch.id then return end

	local chest_id = ch.id
	local config = data.chest_config[chest_id]
	local rewards = chest_loot.generate_chest_rewards(chest_id)
	chest_loot.apply_rewards(rewards)

	poki.chest_opened(chest_id, config and config.name or "Chest")
	poki.happy_time(0.7)

	-- Очищаем слот сундука
	ch.id = nil
	ch.is_opening = false
	ch.unlock_start_time = 0
	state.save()

	refresh_chests_ui(self)
	refresh_text(self)
	refresh_inventory_grid(self)
	refresh_active_deck_ui(self)

	start_chest_reward_sequence(self, rewards)
end


function init(self)
	msg.post(".", "acquire_input_focus")

	self.all_cards_nodes = {}
	self.selected_hero_id = nil
	self.is_waiting_for_swap = false

	self.modal_mode = nil
	self.modal_chest_index = nil
	self.modal_speedup_cost = 0

	state.load()

	gui.set_enabled(gui.get_node("ch_template"), false)
	gui.set_enabled(gui.get_node("end_screen_panel1"), false)
	refresh_chests_ui(self)

	-- Скрываем подсказки на старте (показываем только если это первый запуск и обучение не пройдено)
	gui.set_enabled(gui.get_node("finger"), false)
	gui.set_enabled(gui.get_node("help_text"), false)
	if not state.tutorial_completed and state.tutorial_step == 0 then
		poki.tutorial_started()
		timer.delay(1, false, function()
			if not state.tutorial_completed and state.tutorial_step == 0 then
				gui.set_enabled(gui.get_node("help_text"), true)
				set_tutorial_text(self, "step_1")
				show_finger_anim(self)
			end
		end)
	end

	-- 1. Скрываем ненужное
	self.preview_world = state.selected_world or 1
	show_screen(self, "main_menu")
	show_tab(self, "tab_play")
	gui.set_enabled(gui.get_node("info_box"), false)
	hide_info_box(self)
	self.active_hero_for_info = nil

	-- 2. Заполняем all_cards карточками из heroes_data
	init_inventory(self)
	refresh_active_deck_ui(self)

	refresh_text(self)
	refresh_world_ui(self)
	refresh_settings_ui(self)
	poki.init()
	poki.send_game_ready()
end

function update(self, dt)
	local now = os.time()

	for i = 1, 4 do
		local ch = state.chests[i]
		if ch and ch.id then
			local status_label = gui.get_node("chest_status_" .. i)
			local config = data.chest_config[ch.id]

			if ch.is_opening then
				local elapsed = now - ch.unlock_start_time
				local remaining = config.time - elapsed

				if remaining > 0 then
					gui.set_text(status_label, format_time(remaining))
					gui.set_scale(status_label, vmath.vector3(0.5, 0.5, 1))
					gui.set_color(status_label, vmath.vector4(1, 1, 1, 1))
				else
					gui.set_text(status_label, "OPEN")
					local scale = 0.5 + math.sin(now * 6) * 0.08
					gui.set_scale(status_label, vmath.vector3(scale, scale, 1))
					gui.set_color(status_label, vmath.vector4(0.2, 1.0, 0.2, 1))
				end
			else
				gui.set_text(status_label, "WAIT")
				gui.set_scale(status_label, vmath.vector3(0.5, 0.5, 1))
				gui.set_color(status_label, vmath.vector4(1, 0.9, 0.3, 1))
			end
		end
	end
end


local function update_tab_sizes(self, active_index)
	for i = 1, 3 do
		local node = gui.get_node("tab_btn_" .. i)
		local size = gui.get_size(node)

		if i == active_index then
			size.y = 80
			-- Можно добавить легкую анимацию для сочности
			gui.animate(node, "size.y", 80, gui.EASING_OUTBACK, 0.2)
		else
			size.y = 72
			gui.animate(node, "size.y", 72, gui.EASING_OUTQUAD, 0.2)
		end
	end
end
function on_message(self, message_id, message, sender)
	if message_id == hash("show_turn_msg") then
		local node = gui.get_node("turn_text")
		local turn_string = ""
		if message.team == 1 then
			turn_string = "Your turn"
			gui.set_color(node, vmath.vector4(0.55, 0.3, 1, 1))
		else
			turn_string = "Enemy's turn"
			gui.set_color(node, vmath.vector4(1, 0.45, 0.45, 1))
		end

		gui.set_text(node, turn_string)
		
		--gui.set_color(node, vmath.vector4(1, 1, 1, 1))
		gui.set_scale(node, vmath.vector3(1.5, 1.5, 1))
		gui.animate(node, "scale", vmath.vector3(1, 1, 1), gui.EASING_OUTBACK, 0.4)
		gui.animate(node, "color.w", 0, gui.EASING_INQUAD, 0.5, 1.0)

	elseif message_id == hash("update_queue") or message_id == hash("refresh_queue") then
		refresh_queue_panel(self)
	elseif message_id == hash("game_over") then
		-- Игнорируем game_over, если экран боя выключен (игрок нажал выход или в главном меню)
		if not gui.is_enabled(gui.get_node("main_game")) then
			return
		end

		gui.set_text(gui.get_node("end_screen_title"), message.victory and "VICTORY" or "DEFEAT")
		gui.set_text(gui.get_node("gold_award_txt"), message.coins)
		gui.set_text(gui.get_node("exp_award_txt"), message.prestige)

		local end_screen = gui.get_node("end_screen")
		gui.set_scale(end_screen, vmath.vector3(0.5, 0.5, 1))
		gui.animate(end_screen, "scale", vmath.vector3(1.0, 1.0, 1), gui.EASING_OUTBACK, 0.4)

		if message.victory then
			poki.happy_time(1.0)
			poki.round_end(true, "victory")

			local dropped_chest_id = chest_loot.get_random_chest_drop()
			local placed = false
			for i = 1, 4 do
				if not state.chests[i].id then
					state.chests[i].id = dropped_chest_id
					state.chests[i].unlock_start_time = 0
					state.chests[i].is_opening = false
					state.save()
					placed = true
					break
				end
			end

			local chest_icon = gui.get_node("chest_icon")
			gui.set_enabled(chest_icon, placed)
			if placed then
				local cfg = data.chest_config[dropped_chest_id]
				if cfg then
					gui.set_color(chest_icon, cfg.color)
				end
				gui.set_position(chest_icon, vmath.vector3(0, 120, 0))
				gui.animate(chest_icon, "position.y", -50, gui.EASING_OUTBOUNCE, 0.6)
			end

			-- Spawn celebration flying tokens
			local start_pos = vmath.vector3(0, 0, 0)
			spawn_flying_currency(self, "prestige", 6, start_pos, vmath.vector3(-128, 350, 0), gui.get_node("prestige_block"), function() refresh_text(self) end)
			spawn_flying_currency(self, "coin", 8, start_pos, vmath.vector3(0, 350, 0), gui.get_node("gold_block"), function() refresh_text(self) end)
		else
			poki.round_end(false, "defeat")
			gui.set_enabled(gui.get_node("chest_icon"), false)
		end

		refresh_chests_ui(self)
		gui.set_enabled(gui.get_node("end_screen_panel"), true)
	end

	if message_id == hash("unit_launched") then
		if not state.tutorial_completed and state.tutorial_step == 0 then
			state.tutorial_step = 2
			gui.set_enabled(gui.get_node("finger"), false)
			gui.cancel_animation(gui.get_node("finger"), "position.y")

			set_tutorial_text(self, "step_2")
			timer.delay(4, false, function()
				set_tutorial_text(self, "step_3")
				timer.delay(5, false, function()
					set_tutorial_text(self, "step_4")
					gui.animate(gui.get_node("help_text"), "color.w", 0, gui.EASING_INQUAD, 0.5, 6, function()
						gui.set_enabled(gui.get_node("help_text"), false)
						state.complete_tutorial()
					end)
				end)
			end)
		end
	end
end

function on_input(self, action_id, action)
	if action_id ~= hash("touch") then
		return false
	end

	-- 0. Перетаскивание ползунков громкости в Settings
	if self.active_slider then
		if action.released then
			local finished_slider = self.active_slider
			self.active_slider = nil
			state.save()
			if finished_slider == "sfx" then
				sound.play_hit()
			end
			return true
		else
			update_slider_by_screen_x(self, self.active_slider, action.x)
			return true
		end
	end

	if not action.pressed then
		return false
	end

	-- 1. Обработка модального окна сундука (награды или ускорение)
	if gui.is_enabled(gui.get_node("end_screen_panel1")) then
		local cancel_btn = gui.get_node("cancel_modal_btn1")
		local action_btn = gui.get_node("end_match_btn1")

		if gui.is_enabled(cancel_btn) and gui.pick_node(cancel_btn, action.x, action.y) then
			gui.set_enabled(gui.get_node("end_screen_panel1"), false)
			self.modal_mode = nil
			return true
		end

		if self.modal_mode == "reward_sequence" then
			if gui.pick_node(gui.get_node("end_screen1"), action.x, action.y) or gui.pick_node(action_btn, action.x, action.y) then
				advance_reward_step(self)
				return true
			end
		elseif self.modal_mode == "speedup" then
			if gui.pick_node(action_btn, action.x, action.y) then
				if state.take(0, 0, self.modal_speedup_cost) then
					gui.set_enabled(gui.get_node("end_screen_panel1"), false)
					open_chest(self, self.modal_chest_index)
				else
					local cards_txt = gui.get_node("cards_award_txt1")
					gui.set_text(cards_txt, "Not enough diamonds!\nYou need " .. self.modal_speedup_cost .. " diamonds.")
				end
				return true
			elseif not gui.pick_node(gui.get_node("end_screen1"), action.x, action.y) then
				gui.set_enabled(gui.get_node("end_screen_panel1"), false)
				self.modal_mode = nil
				return true
			end
		end

		return true
	end

	-- 2. Инспектирование юнита на поле боя (окно описания)
	if gui.is_enabled(gui.get_node("info_unit")) then
		local info_bg = gui.get_node("info_bg")
		local close_btn = gui.get_node("close_info_unit_box_btn")

		if gui.pick_node(close_btn, action.x, action.y) or not gui.pick_node(info_bg, action.x, action.y) then
			hide_info_box(self)
			return true
		end
	end

	-- Клик по иконкам очереди в бою
	if gui.is_enabled(gui.get_node("main_game")) then
		for i = 1, 8 do
			local node = gui.get_node("unit_icon_" .. i)
			if gui.is_enabled(node) and gui.pick_node(node, action.x, action.y) then
				local slot_data = unit_manager.get_slot_data(i)
				if slot_data then
					show_info_box(self, slot_data.hero_id, slot_data.hp, slot_data.max_hp, slot_data.level, slot_data.is_dead)
				end
				return true
			end
		end

		if gui.pick_node(gui.get_node("quit_btn"), action.x, action.y) then
			msg.post("main:/game_manager", "cleanup_battle")
			if not state.tutorial_completed then
				state.complete_tutorial()
			end
			poki.gameplay_stop("arena", 1)
			poki.commercial_break()
			refresh_queue_panel(self)
			gui.set_enabled(gui.get_node("end_screen_panel"), false)
			hide_info_box(self)
			show_screen(self, "main_menu")
			return true
		end
	end

	-- 3. Экран результатов матча (Victory / Defeat)
	if gui.is_enabled(gui.get_node("end_screen_panel")) then
		if gui.pick_node(gui.get_node("end_match_btn"), action.x, action.y) then
			refresh_text(self)
			msg.post("main:/game_manager", "cleanup_battle")
			refresh_queue_panel(self)
			if not state.tutorial_completed then
				state.complete_tutorial()
			end
			gui.set_enabled(gui.get_node("end_screen_panel"), false)
			poki.gameplay_stop("arena", 1)
			poki.commercial_break()
			hide_info_box(self)
			show_screen(self, "main_menu")
			return true
		end
	end

	-- 4. Главное меню и вкладки
	if gui.is_enabled(gui.get_node("main_menu")) then
		if gui.pick_node(gui.get_node("tab_btn_1"), action.x, action.y) then
			show_tab(self, "tab_play")
			update_tab_sizes(self, 1)
			return true
		elseif gui.pick_node(gui.get_node("tab_btn_2"), action.x, action.y) then
			show_tab(self, "tab_inventory")
			update_tab_sizes(self, 2)
			refresh_inventory_grid(self)
			return true
		elseif gui.pick_node(gui.get_node("tab_btn_3"), action.x, action.y) then
			show_tab(self, "tab_settings")
			update_tab_sizes(self, 3)
			return true
		end

		-- Вкладка PLAY: Клик по сундукам
		if gui.is_enabled(gui.get_node("tab_play")) then
			for i = 1, 4 do
				if gui.pick_node(gui.get_node("ch_" .. i), action.x, action.y) then
					local ch = state.chests[i]
					if not ch or not ch.id then return true end

					local now = os.time()
					local config = data.chest_config[ch.id]
					local remaining = config.time - (now - ch.unlock_start_time)

					if not ch.is_opening then
						if state.is_any_chest_opening() then
							show_speedup_modal(self, i)
						else
							ch.is_opening = true
							ch.unlock_start_time = now
							state.save()
							refresh_chests_ui(self)
						end
					elseif remaining <= 0 then
						open_chest(self, i)
					else
						show_speedup_modal(self, i)
					end
					return true
				end
			end

			-- Перелистывание миров: кнопка ВЛЕВО (<)
			if gui.pick_node(gui.get_node("btn_world_prev"), action.x, action.y) then
				self.preview_world = (self.preview_world or 1) - 1
				if self.preview_world < 1 then self.preview_world = #state.WORLDS end
				sound.play_bounce(false)
				gui.set_scale(gui.get_node("world_card"), vmath.vector3(0.92, 0.92, 1))
				gui.animate(gui.get_node("world_card"), "scale", vmath.vector3(1, 1, 1), gui.EASING_OUTBACK, 0.2)
				if state.is_world_unlocked(self.preview_world) then
					state.select_world(self.preview_world)
					pcall(msg.post, "/arena/arena_loader#script", "change_world", { world_id = self.preview_world })
				end
				refresh_world_ui(self)
				return true
			end

			-- Перелистывание миров: кнопка ВПРАВО (>)
			if gui.pick_node(gui.get_node("btn_world_next"), action.x, action.y) then
				self.preview_world = (self.preview_world or 1) + 1
				if self.preview_world > #state.WORLDS then self.preview_world = 1 end
				sound.play_bounce(false)
				gui.set_scale(gui.get_node("world_card"), vmath.vector3(0.92, 0.92, 1))
				gui.animate(gui.get_node("world_card"), "scale", vmath.vector3(1, 1, 1), gui.EASING_OUTBACK, 0.2)
				if state.is_world_unlocked(self.preview_world) then
					state.select_world(self.preview_world)
					pcall(msg.post, "/arena/arena_loader#script", "change_world", { world_id = self.preview_world })
				end
				refresh_world_ui(self)
				return true
			end

			-- Клик по карточке мира или кнопке статуса
			if gui.pick_node(gui.get_node("world_card"), action.x, action.y) or gui.pick_node(gui.get_node("world_status_btn"), action.x, action.y) then
				if state.is_world_unlocked(self.preview_world) then
					if state.selected_world ~= self.preview_world then
						sound.play_bounce(false)
						state.select_world(self.preview_world)
						pcall(msg.post, "/arena/arena_loader#script", "change_world", { world_id = self.preview_world })
						gui.set_scale(gui.get_node("world_card"), vmath.vector3(0.9, 0.9, 1))
						gui.animate(gui.get_node("world_card"), "scale", vmath.vector3(1, 1, 1), gui.EASING_OUTBACK, 0.25)
						refresh_world_ui(self)
					end
				else
					-- Заблокировано: легкая тряска карточки
					sound.play_bounce(true)
					local orig_x = gui.get_position(gui.get_node("world_card")).x
					gui.animate(gui.get_node("world_card"), "position.x", orig_x - 8, gui.EASING_OUTQUAD, 0.05, 0, function()
						gui.animate(gui.get_node("world_card"), "position.x", orig_x + 8, gui.EASING_OUTQUAD, 0.05, 0, function()
							gui.animate(gui.get_node("world_card"), "position.x", orig_x, gui.EASING_OUTQUAD, 0.05)
						end)
					end)
				end
				return true
			end

			-- Кнопка "В БОЙ"
			if gui.pick_node(gui.get_node("btn_play"), action.x, action.y) then
				gui.set_scale(gui.get_node("tab_play"), vmath.vector3(1, 1, 1))
				gui.animate(gui.get_node("tab_play"), "scale.x", 1.2, gui.EASING_OUTQUAD, 0.1, 0, function()
					gui.animate(gui.get_node("tab_play"), "scale.x", 1.0, gui.EASING_OUTBACK, 0.2)
				end)
				gui.animate(gui.get_node("tab_play"), "scale.y", 0.8, gui.EASING_OUTQUAD, 0.1, 0, function()
					gui.animate(gui.get_node("tab_play"), "scale.y", 1.0, gui.EASING_OUTBACK, 0.2)
				end)
				start_lobby_search(self)
				return true
			end
		end

		-- Вкладка INVENTORY: Карточки, улучшение, замена в колоде
		if gui.is_enabled(gui.get_node("tab_inventory")) then
			-- Замена в активной колоде (Deck Swap)
			if self.is_waiting_for_swap and self.selected_hero_id then
				for i = 1, 4 do
					local slot_node = gui.get_node("active_slot_" .. i)
					if slot_node and gui.pick_node(slot_node, action.x, action.y) then
						-- Проверяем, стоял ли уже этот герой в другом слоте (рокировка)
						local existing_slot = nil
						for s = 1, 4 do
							if state.active_deck[s] == self.selected_hero_id then
								existing_slot = s
								break
							end
						end

						if existing_slot and existing_slot ~= i then
							state.active_deck[existing_slot] = state.active_deck[i]
						end

						state.active_deck[i] = self.selected_hero_id
						state.save()

						self.is_waiting_for_swap = false
						gui.set_enabled(gui.get_node("choose_txt"), false)
						stop_deck_swap_highlight(self)
						return true
					end
				end
			end

			-- Просмотр героя из активного слота (если не в режиме замены)
			if not self.is_waiting_for_swap then
				for i = 1, 4 do
					local slot_node = gui.get_node("active_slot_" .. i)
					if slot_node and gui.pick_node(slot_node, action.x, action.y) then
						local h_id = state.active_deck[i]
						if h_id then
							self.selected_hero_id = h_id
							update_info_box(self, h_id)
							update_info_panel(self, h_id)
							return true
						end
					end
				end
			end

			-- Клик по кнопке улучшения (Upgrade)
			if gui.is_enabled(gui.get_node("info_box")) and gui.pick_node(gui.get_node("upgrade_btn"), action.x, action.y) and self.selected_hero_id then
				local h_id = self.selected_hero_id
				local current_level = state.hero_levels[h_id] or 1
				local player_cards = state.hero_cards[h_id] or 0
				local can_up, gold_cost, cards_req = data.can_upgrade(h_id, current_level, state.gold, player_cards)

				if can_up and state.take(0, gold_cost, 0) then
					state.hero_cards[h_id] = player_cards - cards_req
					state.hero_levels[h_id] = current_level + 1
					state.save()

					poki.hero_upgraded(h_id, current_level + 1)
					poki.happy_time(0.6)

					update_info_box(self, h_id)
					update_info_panel(self, h_id)
					refresh_text(self)
					refresh_inventory_grid(self)
					refresh_active_deck_ui(self)
				end
				return true
			end

			-- Клик по кнопке USE (взять в колоду)
			if gui.is_enabled(gui.get_node("info_box")) and gui.pick_node(gui.get_node("use_btn"), action.x, action.y) and self.selected_hero_id then
				self.is_waiting_for_swap = true
				gui.set_enabled(gui.get_node("info_box"), false)
				start_deck_swap_highlight(self)
				local choose_label = gui.get_node("choose_txt")
				gui.set_enabled(choose_label, true)
				gui.set_color(choose_label, vmath.vector4(1, 1, 1, 1))
				gui.cancel_animation(choose_label, "color.w")
				gui.animate(choose_label, "color.w", 0, gui.EASING_INQUAD, 0.5, 4.0, function()
					if not self.is_waiting_for_swap then
						gui.set_enabled(choose_label, false)
					end
				end)
				return true
			end

			-- Закрытие info_box
			if gui.is_enabled(gui.get_node("info_box")) and gui.pick_node(gui.get_node("close_info_box_btn"), action.x, action.y) then
				if self.is_waiting_for_swap then
					self.is_waiting_for_swap = false
					stop_deck_swap_highlight(self)
					gui.set_enabled(gui.get_node("choose_txt"), false)
				end
				gui.set_enabled(gui.get_node("info_box"), false)
				return true
			end

			-- Выбор карточки из сетки инвентаря
			for _, item in ipairs(self.all_cards_nodes) do
				if item.root and gui.is_enabled(item.root) and gui.pick_node(item.root, action.x, action.y) then
					if self.is_waiting_for_swap then
						self.is_waiting_for_swap = false
						stop_deck_swap_highlight(self)
						gui.set_enabled(gui.get_node("choose_txt"), false)
					end
					self.selected_hero_id = item.hero_id
					update_info_box(self, item.hero_id)
					update_info_panel(self, item.hero_id)
					return true
				end
			end

			-- Если были в режиме ожидания выбора слота и кликнули мимо — сбрасываем подсветку
			if self.is_waiting_for_swap then
				self.is_waiting_for_swap = false
				stop_deck_swap_highlight(self)
				gui.set_enabled(gui.get_node("choose_txt"), false)
				return true
			end
		end

		-- Вкладка SETTINGS: Ползунки громкости звука и музыки
		if gui.is_enabled(gui.get_node("tab_settings")) then
			if gui.pick_node(gui.get_node("sfx_bar_bg"), action.x, action.y) or gui.pick_node(gui.get_node("sfx_pin"), action.x, action.y) then
				self.active_slider = "sfx"
				update_slider_by_screen_x(self, "sfx", action.x)
				return true
			elseif gui.pick_node(gui.get_node("music_bar_bg"), action.x, action.y) or gui.pick_node(gui.get_node("music_pin"), action.x, action.y) then
				self.active_slider = "music"
				update_slider_by_screen_x(self, "music", action.x)
				return true
			end
		end
	end

	return false
end

function final(self)
	state.save()
end