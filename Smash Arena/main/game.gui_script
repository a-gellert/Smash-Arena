-- game.gui_script
local state = require "main.state"
local poki = require "main.poki"
local data = require "main.heroes_data"
local unit_manager = require "main.unit_manager"


local LANG = "en" 
-- Предполагаем, что здесь лежат данные игрока (инвентарь, уровни, текущая колода)
-- Если модуля нет, создай его или используй глобальную таблицу для теста
local player = {
	active_squad = { 1, 2, 3, 4 }, -- Первые 4 героя по умолчанию
	inventory = {}, -- Тут можно хранить кол-во карточек
	levels = {}     -- Тут уровни
}

local function set_tutorial_text(self, text_key)
	local label = gui.get_node("help_text")
	gui.set_text(label, state.STRINGS[text_key][LANG])

	-- "Сочное" появление текста
	gui.set_scale(label, vmath.vector3(0.8, 0.8, 1))
	gui.animate(label, "scale", vmath.vector3(1, 1, 1), gui.EASING_OUTBACK, 0.3)
end

local function show_finger_anim(self)
	local finger = gui.get_node("finger")
	gui.set_enabled(finger, true)

	-- Начальная позиция пальца (чуть выше центра или над героем)
	local start_pos = vmath.vector3(0, 50, 0) -- Настрой под свои координаты
	gui.set_position(finger, start_pos)

	-- Анимация: ведем вниз и повторяем
	gui.animate(finger, "position.y", start_pos.y - 150, gui.EASING_INOUTQUAD, 1.0, 0, nil, gui.PLAYBACK_LOOP_FORWARD)
end



local function refresh_active_deck_ui(self)
	for i = 1, 4 do
		local hero_id = state.active_deck[i]
		local level_label = gui.get_node("active_level_txt_" .. i)
		local icon_node = gui.get_node("active_icon_" .. i)

		if hero_id then
			-- Достаем статические данные героя (имя, иконку и т.д.)
			local hero_static = data.heroes[hero_id]
			local level = state.hero_levels[hero_id] or 1

			if hero_static then
				-- Уровень
				gui.set_text(level_label, "Lvl " .. level)

				-- Иконка: используем name_key из твоей таблицы M.heroes
				-- Обязательно оборачиваем в hash()
				local anim_id = hash(hero_static.name_key)
				gui.play_flipbook(icon_node, anim_id)

				gui.set_enabled(icon_node, true)
				gui.set_alpha(icon_node, 1.0)
			end
		else
			-- Если слот пустой (например, в начале игры)
			gui.set_text(level_label, "")
			gui.set_alpha(icon_node, 0.2)
			-- Можно либо выключить ноду, либо оставить полупрозрачной
			-- gui.set_enabled(icon_node, false)
		end
	end
end
local function refresh_text(self)
	local prestige_node = gui.get_node("prestige_txt")
	local gold_node     = gui.get_node("gold_txt")
	local almaz_node    = gui.get_node("almaz_txt")

	gui.set_text(prestige_node, tostring(state.prestige))
	gui.set_text(gold_node,     tostring(state.gold))
	gui.set_text(almaz_node,    tostring(state.almaz))
end
local function refresh_inventory_grid(self)
	for _, item in ipairs(self.all_cards_nodes) do
		local hero_id = item.hero_id

		-- Данные из state
		local current_level = state.hero_levels[hero_id] or 1
		local player_cards = state.hero_cards[hero_id] or 0
		local cards_req = current_level * 5

		-- Прямое обновление через сохраненные ссылки
		if item.level_node then
			gui.set_text(item.level_node, current_level)
		end

		if item.count_node then
			gui.set_text(item.count_node, player_cards .. "/" .. cards_req)

			-- Подсветка готовности к апгрейду
			if player_cards >= cards_req then
				gui.set_color(item.count_node, vmath.vector4(0, 1, 0, 1))
			else
				gui.set_color(item.count_node, vmath.vector4(1, 1, 1, 1))
			end
		end
	end
end
local function update_info_panel(self, hero_id)
	self.selected_hero_id = hero_id
	local current_level = state.hero_levels[hero_id] or 1
	local player_cards = state.hero_cards[hero_id] or 0

	-- Получаем статы из heroes_data
	local stats = data.get_stats(hero_id, current_level)

	-- Проверка возможности апгрейда
	local can_up, gold_cost, cards_req = data.can_upgrade(hero_id, current_level, state.gold, player_cards)

	-- Отрисовка
	gui.set_text(gui.get_node("unit_level"),  current_level)
	gui.set_text(gui.get_node("upgrade_price_label"), gold_cost .. " coins")
	gui.set_text(gui.get_node("upgrade_cards_label"), player_cards .. " / " .. cards_req)

	-- Визуальный фидбек кнопки (смена цвета если не хватает денег/карт)
	local upgrade_btn = gui.get_node("upgrade_btn")
	if can_up then
		gui.set_color(upgrade_btn, vmath.vector4(1, 1, 1, 1)) -- Активна
	else
		gui.set_color(upgrade_btn, vmath.vector4(0.5, 0.5, 0.5, 1)) -- Заблокирована
	end
end
-- Константы разметки инвентаря
local ITEM_SIZE = 80
local GRID_COLS = 4
local PADDING = 10

--------------------------
-- Утилитарные функции
--------------------------

local function hide_info_box(self)
	gui.set_enabled(gui.get_node("info_unit"), false)
end
-- Функция заполнения окна данными (наш "Report Builder")
local function show_info_box(self, hero_id, current_hp, max_hp, level)
	local window_w, window_h = window.get_size()
	local scale_val = 1 -- По умолчанию портрет

	if window_w > window_h then
		scale_val = 2 -- Ландшафт
	end

	gui.set_scale(gui.get_node("info_unit"), vmath.vector3(scale_val, scale_val, 1))
	
	local hero_base = data.heroes[hero_id]
	local stats = data.get_stats(hero_id, level)

	-- Заполняем текстовые поля
	gui.set_text(gui.get_node("info_unit_name"), data.get_name(hero_id, "en"))
	gui.set_text(gui.get_node("info_unit_description"), data.get_description(hero_id, "en"))
	gui.set_text(gui.get_node("info_unit_hp_txt"), current_hp .. "/" .. max_hp)
	gui.set_text(gui.get_node("info_unit_damage_txt"),  stats.damage)
	gui.set_text(gui.get_node("info_unit_speed_txt"), (stats.speed or "Норм"))

	gui.set_enabled(gui.get_node("info_unit"), true)
	local icon_path = hero_base.name_key 
	gui.play_flipbook(gui.get_node("info_unit_icon"), hash(icon_path))
	-- Меняем иконку (предполагаем, что имя кадра в атласе совпадает с hero_id или прописано в data)
	
end
local function refresh_queue_panel(self)
	for i = 1, 8 do
		local unit_id = unit_manager.get_id_by_index(i)
		local icon_node = gui.get_node("unit_icon_" .. i)

		if unit_id then
			local cached = unit_manager.unit_data[unit_id]
			if cached and cached.hero_id then
				-- 1. Получаем данные конкретного героя из твоей таблицы M.heroes
				local hero_id = cached.hero_id
				local hero_static_data = data.heroes[hero_id]

				-- 2. Берем name_key именно этого героя
				if hero_static_data then
					local name = data.get_name(hero_id, "en")
--					gui.set_text(gui.get_node("unit_icon_text_" .. i), name)

					-- 3. Достаем ключ анимации (например, "paladin_name")
					local anim_id = hash(hero_static_data.name_key)

					-- 4. Запускаем (убедись, что нода "ico_1" и т.д. существует)
					gui.play_flipbook(gui.get_node("ico_" .. i), anim_id)
				end
			end
			gui.set_enabled(icon_node, true)
		else
			gui.set_enabled(icon_node, false)
		end
	end
end
local function run_tutorial_logic(self)
	if state.tutorial_step == 1 then
		-- Показываем стрелку на кнопку "В БОЙ"
		gui.set_visible(self.tutorial_arrow, true)
		gui.set_position(self.tutorial_arrow, gui.get_position(self.btn_start_battle))
		gui.set_text(self.tutorial_label, "Это твоя команда. Пора в бой!")
	elseif state.tutorial_step == 4 then
		-- Подсказка на сундук в главном меню
		gui.set_visible(self.tutorial_arrow, true)
		gui.set_position(self.tutorial_arrow, gui.get_position(self.chest_node))
		gui.set_text(self.tutorial_label, "Смотри, ты заработал трофей!")
	end
end


local function show_screen(self, screen_name)
	local screens = { "main_menu", "lobby_screen", "main_game" }
	for _, name in ipairs(screens) do
		gui.set_enabled(gui.get_node(name), name == screen_name)
	end
end

local function show_tab(self, tab_name)
	local tabs = { "tab_play", "tab_inventory", "tab_settings" }
	for _, name in ipairs(tabs) do
		gui.set_enabled(gui.get_node(name), name == tab_name)
	end
end

-- Обновление информации о герое в Info Box
local function update_info_box(self, hero_id)
	local hero = data.heroes[hero_id]
	local level = state.hero_levels[hero_id] or 1
	local stats = data.get_stats(hero_id, level)
	local window_w, window_h = window.get_size()
	local scale_val = 1 -- По умолчанию портрет
	local y =180

	if window_w > window_h then
		scale_val = 1.5 -- Ландшафт
		y= 100
	end

	gui.set_scale(gui.get_node("info_box"), vmath.vector3(scale_val, scale_val, 1))
	gui.set_position(gui.get_node("info_box"), vmath.vector3(0, y, 1))
	gui.set_text(gui.get_node("unit_name"), data.strings[hero.name_key].en)

	-- Заменяем плейсхолдер ability_value на реальное число
	local desc = data.strings[hero.desc_key].en:gsub("ability_value", tostring(hero.ability_value))
	gui.set_text(gui.get_node("unit_description"), desc)

	gui.set_text(gui.get_node("unit_hp_txt"),  stats.hp)
	gui.set_text(gui.get_node("unit_damage_txt"),  stats.damage)
	gui.set_text(gui.get_node("unit_speed_txt"),  string.format("%.1f", stats.speed))
	
	local hero_data = data.heroes[hero_id]
	-- Собираем путь к кадру. ВАЖНО: hash() применяется ко ВСЕЙ строке пути, а не к её части.
	local icon_path = hero_data.name_key 
	gui.play_flipbook(gui.get_node("unit_icon"), hash(icon_path))
	--gui.play_flipbook(gui.get_node("unit_icon"),frame_name)
	-- Показываем Info Box, если он был скрыт
	gui.set_enabled(gui.get_node("info_box"), true)
end

-- Обновление иконок активной колоды
local function refresh_active_deck(self)
	for i = 1, 4 do
		local hero_id = player.active_squad[i]
		local slot_node = gui.get_node("active_slot_" .. i)
		-- Здесь можно менять текстуру/цвет в зависимости от героя
		-- Пока просто красим в цвет редкости (заглушка)
		local rarity = data.heroes[hero_id].rarity
		local color = vmath.vector4(0.5, 0.5, 0.5, 1) -- По умолчанию
		if rarity == 2 then color = vmath.vector4(0.2, 0.6, 1, 1) end
		if rarity == 3 then color = vmath.vector4(0.7, 0.2, 1, 1) end
		gui.set_color(slot_node, color)
	end
end

local function start_lobby_search(self)
	show_screen(self, "lobby_screen")
	local search_time =  0.1--1.5 + math.random() * 1.5

	timer.delay(search_time, false, function()
		print("Противник найден!")
		show_screen(self, "main_game")
		msg.post("main:/game_manager", "init_battle")
	end)
	timer.delay(0.3, false, function() refresh_queue_panel(self) end)
end

--------------------------
-- Жизненный цикл
--------------------------
local function init_inventory(self)
	local parent = gui.get_node("all_cards")
	local template_node = gui.get_node("unit_card_template")
	gui.set_enabled(template_node, false)

	self.all_cards_nodes = {}

	for i = 1, #data.heroes do
		local hero = data.heroes[i]
		local nodes = gui.clone_tree(template_node)

		-- ВНИМАНИЕ: Проверь эти ID в окне Outline в Defold!
		-- Если нода называется "level", то пиши hash("level")
		local root = nodes[hash("unit_card_template")]
		local icon = nodes[hash("unit_card_icon")]
		local level_txt = nodes[hash("unit_level")]
		local count_txt = nodes[hash("unit_card_count_template")]

		-- Отладка: если падает, раскомментируй строку ниже и посмотри в консоль
		-- pprint(nodes) 

		if root then
			gui.set_parent(root, parent)
			gui.set_enabled(root, true)

			-- Безопасная установка иконки
			if icon then
				local icon_path = hero.name_key 
				gui.play_flipbook(icon, hash(icon_path))
			else
				print("ОШИБКА: Нода иконки не найдена! Проверь ID.")
			end

			-- Безопасная установка уровня
			if level_txt then
				local level = state.hero_levels[hero.id] or 1
				gui.set_text(level_txt, level)
			else
				-- Если ты здесь, значит в хеше ошибка
				print("ОШИБКА: Нода уровня не найдена. Ищу: unit_card_level_template")
			end

			-- Позиционирование
			local row = math.floor((i - 1) / GRID_COLS)

			local col = (i - 1) % GRID_COLS

			local pos = vmath.vector3(col * (ITEM_SIZE + PADDING) - 135, -row * (ITEM_SIZE + PADDING) + 135, 0)

			gui.set_position(root, pos)
			table.insert(self.all_cards_nodes, { 
				hero_id = hero.id, 
				root = root,
				level_node = level_txt,
				count_node = count_txt,
				icon_node = icon
			})
		end
	end
end
function init(self)
	msg.post(".", "acquire_input_focus")

	self.all_cards_nodes = {} -- Ссылки на созданные карточки
	self.selected_hero_id = nil
	self.is_waiting_for_swap = false

	-- Скрываем всё на старте
	gui.set_enabled(gui.get_node("finger"), false)
	gui.set_enabled(gui.get_node("help_text"), false)
	if state.tutorial_step == 0 then
		timer.delay(1, false, function()
			gui.set_enabled(gui.get_node("help_text"), true)
			set_tutorial_text(self, "step_1")
			show_finger_anim(self)
		end)
	end


	
	-- 1. Скрываем ненужное
	show_screen(self, "main_menu")
	show_tab(self, "tab_play")
	gui.set_enabled(gui.get_node("info_box"), false)
	hide_info_box(self)
	self.active_hero_for_info = nil -- Храним, кого сейчас "инспектируем"
	-- 2. Заполняем all_cards карточками из heroes_data
	-- Внутри функции init(self)
	init_inventory(self)
	refresh_active_deck_ui(self)
	-- 3. Рисуем начальную колоду
	refresh_active_deck(self)

	refresh_text(self)

--	poki.gameplay_start()
--	bridge.platform.send_message("game_ready")
end
local function update_tab_sizes(self, active_index)
	for i = 1, 3 do
		local node = gui.get_node("tab_btn_" .. i)
		local size = gui.get_size(node)

		if i == active_index then
			size.y = 80
			-- Можно добавить легкую анимацию для сочности
			gui.animate(node, "size.y", 80, gui.EASING_OUTBACK, 0.2)
		else
			size.y = 72
			gui.animate(node, "size.y", 72, gui.EASING_OUTQUAD, 0.2)
		end
	end
end
function on_message(self, message_id, message, sender)
	if message_id == hash("show_turn_msg") then
		local node = gui.get_node("turn_text")
		local turn_string = ""
		if message.team == 1 then
			turn_string = "Your turn"
			gui.set_color(node, vmath.vector4(0.55, 0.3, 1, 1))
		else
			turn_string = "Enemy's turn"
			gui.set_color(node, vmath.vector4(1, 0.45, 0.45, 1))
		end

		gui.set_text(node, turn_string)
		
		--gui.set_color(node, vmath.vector4(1, 1, 1, 1))
		gui.set_scale(node, vmath.vector3(1.5, 1.5, 1))
		gui.animate(node, "scale", vmath.vector3(1, 1, 1), gui.EASING_OUTBACK, 0.4)
		gui.animate(node, "color.w", 0, gui.EASING_INQUAD, 0.5, 1.0)

	elseif message_id == hash("update_queue") then
		for i=1, 8 do
			local icon_node = gui.get_node("ico_" .. i)
			if not message.queue[i] then
				gui.set_color(icon_node, vmath.vector4(0.7, 0.5, 0.6, 1))
			else
				gui.set_color(icon_node, vmath.vector4(1, 1, 1, 1)) -- сбрасываем в белый
			end
			
		end
		refresh_queue_panel(self)
	elseif message_id == hash("game_over") then
		gui.set_text(gui.get_node("end_screen_title"), message.victory and "VICTORY" or "DEFEAT")
		gui.set_text(gui.get_node("gold_award_txt"), message.coins)
		gui.set_text(gui.get_node("exp_award_txt"), message.prestige)
		gui.set_enabled(gui.get_node("end_screen_panel"), true)
	end
	if message_id == hash("unit_launched") then
		if state.tutorial_step == 0 then
			state.tutorial_step = 2
			-- Убираем палец
			gui.set_enabled(gui.get_node("finger"), false)
			gui.cancel_animation(gui.get_node("finger"), "position.y")

			-- Шаг 2: Про способности
			set_tutorial_text(self, "step_2")

			-- Через 3 секунды показываем пример про Танка
			timer.delay(4, false, function()
				set_tutorial_text(self, "step_3")

				-- Еще через 4 секунды финальное напутствие
				timer.delay(5, false, function()
					set_tutorial_text(self, "step_4")

					-- И наконец скрываем всё обучение через 3 секунды
					gui.animate(gui.get_node("help_text"), "color.w", 0, gui.EASING_INQUAD, 0.5, 6, function()
						gui.set_enabled(gui.get_node("help_text"), false)
					end)
				end)
			end)
		end
		
	end
end

function on_input(self, action_id, action)
	if action_id ~= hash("touch") or not action.pressed then
		return false
	end
	if self.is_waiting_for_swap then
		for i = 1, 4 do
			local slot_node = gui.get_node("active_slot_" .. i) 

			if slot_node and gui.pick_node(slot_node, action.x, action.y) then
				-- Обновляем данные в таблице из модуля state
				state.active_deck[i] = self.selected_hero_id
				state.save()

				-- Выключаем режим ожидания клика
				self.is_waiting_for_swap = false

				-- Скрываем подсказку "Выберите слот"
				gui.set_enabled(gui.get_node("choose_txt"), false)

				-- ВАЖНО: Обновляем визуал колоды
				refresh_active_deck_ui(self) 
				return true 
			end
		end
	end
	if gui.pick_node(gui.get_node("upgrade_btn"), action.x, action.y) then
		local h_id = self.selected_hero_id
		local current_level = state.hero_levels[h_id] or 1
		local player_cards = state.hero_cards[h_id] or 0

		local can_up, gold_cost, cards_req = data.can_upgrade(h_id, current_level, state.gold, player_cards)

		-- Используем нашу новую функцию
		if can_up and state.take(0, gold_cost, 0) then
			-- Списываем карточки (они обычно вне общей функции take)
			state.hero_cards[h_id] = state.hero_cards[h_id] - cards_req
			state.hero_levels[h_id] = current_level + 1

			state.save()


			update_info_box(self, h_id) -- Общее инфо
		
			refresh_text(self)        -- Обновит золото в шапке
			update_info_panel(self, h_id) 
			refresh_inventory_grid(self)
			refresh_active_deck(self)
			refresh_active_deck_ui(self) 
		else
			print("Транзакция отклонена: не хватает золота или карт")
		end
		return true
	end
	-- 1. Сначала проверяем закрытие окна (если оно открыто)
	if gui.is_enabled(gui.get_node("info_unit")) then
		local info_bg = gui.get_node("info_bg")
		local close_btn = gui.get_node("close_info_unit_box_btn")

		if gui.pick_node(close_btn, action.x, action.y) or not gui.pick_node(info_bg, action.x, action.y) then
			hide_info_box(self)
			return true -- Мы закрыли окно, дальше клик не пропускаем
		end
	end

	-- 2. Логика клика по иконкам очереди (ТЕПЕРЬ СНАРУЖИ)
	-- Проверяем иконки только если мы в бою
	if gui.is_enabled(gui.get_node("main_game")) then
		for i = 1, 8 do
			local node = gui.get_node("unit_icon_" .. i)
			if gui.is_enabled(node) and gui.pick_node(node, action.x, action.y) then
				local team_id = (i <= 4) and 1 or 2
				local unit_idx = (i <= 4) and i or (i - 4)
				local unit_id = unit_manager.teams[team_id][unit_idx]

				local cached_data = unit_manager.unit_data[unit_id]
				if cached_data then
					show_info_box(self, cached_data.hero_id, cached_data.hp, cached_data.max_hp, cached_data.level)
				end
				return true -- Нашли нажатие, выходим
			end
		end
	end

	-- 3. НАВИГАЦИЯ (Главное меню)
	if gui.is_enabled(gui.get_node("main_menu")) then
		if gui.pick_node(gui.get_node("tab_btn_1"), action.x, action.y) then
			show_tab(self, "tab_play")
			update_tab_sizes(self, 1)
			return true
		elseif gui.pick_node(gui.get_node("tab_btn_2"), action.x, action.y) then
			show_tab(self, "tab_inventory")
			update_tab_sizes(self, 2)
			return true
		elseif gui.pick_node(gui.get_node("tab_btn_3"), action.x, action.y) then
			show_tab(self, "tab_settings")
			update_tab_sizes(self, 3)
			return true
		end

		-- Кнопка "В БОЙ"
		if gui.is_enabled(gui.get_node("tab_play")) and gui.pick_node(gui.get_node("btn_play"), action.x, action.y) then
		
			gui.set_scale(gui.get_node("tab_play"), vmath.vector3(1, 1, 1))
			gui.animate(gui.get_node("tab_play"), "scale.x", 1.2, gui.EASING_OUTQUAD, 0.1, 0, function()
				gui.animate(gui.get_node("tab_play"), "scale.x", 1.0, gui.EASING_OUTBACK, 0.2)
			end)
			gui.animate(gui.get_node("tab_play"), "scale.y", 0.8, gui.EASING_OUTQUAD, 0.1, 0, function()
				gui.animate(gui.get_node("tab_play"), "scale.y", 1.0, gui.EASING_OUTBACK, 0.2)
			end)

			start_lobby_search(self)
			poki.gameplay_start()
			--bridge.platform.send_message("level_started")
			return true
		end
	end

	-- 4. ЛОГИКА ИНВЕНТАРЯ
	if gui.is_enabled(gui.get_node("tab_inventory")) then
		for _, item in ipairs(self.all_cards_nodes) do
			-- Проверяем, что нода существует И она видна (enabled)
			if item.root and gui.is_enabled(item.root) then
				if gui.pick_node(item.root, action.x, action.y) then
					self.selected_hero_id = item.hero_id
					self.is_waiting_for_swap = false

					-- Обновляем данные в окне инфо
					update_info_box(self, item.hero_id) -- Общее инфо
					update_info_panel(self, item.hero_id) -- Кнопка апгрейда

					return true
				end
			end
		end
	

		-- Кнопка USE
		if gui.pick_node(gui.get_node("use_btn"), action.x, action.y) and self.selected_hero_id then
			self.is_waiting_for_swap = true
			gui.set_enabled(gui.get_node("info_box"), false)
			local node = gui.get_node("choose_txt")

			-- 1. Сразу делаем текст видимым и непрозрачным
			gui.set_enabled(node, true)
			gui.set_color(node, vmath.vector4(1, 1, 1, 1)) -- Альфа = 1

			-- 2. Запускаем анимацию исчезновения:
			-- "color.w" — это прозрачность (alpha)
			-- 0 — конечное значение (невидимый)
			-- 0.5 — длительность самого исчезновения (полсекунды)
			-- 2.0 — ЗАДЕРЖКА перед началом (то самое время, когда текст висит)
			gui.animate(node, "color.w", 0, gui.EASING_INQUAD, 0.5, 2.0, function()
				-- Когда анимация закончится, полностью выключаем ноду
				gui.set_enabled(node, false)
			end)
			return true
		end-- Кнопка USE
		if gui.pick_node(gui.get_node("close_info_box_btn"), action.x, action.y) and self.selected_hero_id then
			self.is_waiting_for_swap = true
			gui.set_enabled(gui.get_node("info_box"), false)
			return true
		end

		-- Замена в активной колоде
		if self.is_waiting_for_swap then
			for i = 1, 4 do
				if gui.pick_node(gui.get_node("active_slot_" .. i), action.x, action.y) then
					gui.set_enabled(gui.get_node("choose_txt"), false)
					player.active_squad[i] = self.selected_hero_id
					self.is_waiting_for_swap = false
					refresh_active_deck(self)

					return true
				end
			end
		end
	end

	-- 5. ВЫХОД ИЗ БОЯ
	if gui.is_enabled(gui.get_node("main_game")) then
		if gui.pick_node(gui.get_node("quit_btn"), action.x, action.y)  then
			msg.post("main:/game_manager", "cleanup_battle")
			state.tutorial_step = 10
			poki.gameplay_stop()
		--	bridge.platform.send_message("level_completed")
			refresh_queue_panel(self)

			gui.set_enabled(gui.get_node("end_screen_panel"), false)
			-- 4. Скрываем окно информации, если оно было открыто
			hide_info_box(self)
			show_screen(self, "main_menu")
			return true
		end
	end
	if  gui.is_enabled(gui.get_node("end_screen_panel"))  then
	
		if gui.pick_node(gui.get_node("end_match_btn"), action.x, action.y)  then
			refresh_text(self)  
			msg.post("main:/game_manager", "cleanup_battle")
			refresh_queue_panel(self)
			state.tutorial_step = 3
			gui.set_enabled(gui.get_node("end_screen_panel"), false)
			-- 4. Скрываем окно информации, если оно было открыто
			hide_info_box(self)
			show_screen(self, "main_menu")
			return true
		end
	end

	return false -- Если никуда не попали, отдаем ввод другим системам
end