-- unit.script
local state = require "main.state"

go.property("team_type", 1) 
go.property("max_hp", 100)
go.property("damage", 20)
go.property("level", 1)
local time = 2

function init(self)
	self.current_hp = self.max_hp
	self.is_moving = false
	self.damage_dealt = false
	go.set("#hp_fill", "tint", vmath.vector4(1, 0.15, 0.15, 1))
	msg.post("/unit_manager#unit_manager", "register_unit", { team = self.team_type })
	if self.team_type == 1 then
		go.set("#platform", "tint", vmath.vector4(1, 0, 1, 1))
	else

			go.set("#platform", "tint", vmath.vector4(1, 1, 0, 1))
	end
	self.color = go.get("#platform", "tint")
end
local function update_hp_bar(self)
	local quota = self.current_hp / self.max_hp
	print(quota)
	-- Ограничиваем, чтобы не ушло в минус
	quota = math.max(0, quota)
	-- Меняем масштаб зеленой полоски по X
	go.set("#hp_fill", "scale.x", 11.5 * quota)
end
function update(self, dt)
	if not self.is_moving then return end

	local vel = go.get("#collisionobject", "linear_velocity")
	local speed = vmath.length(vel)
	
time = time - dt
if time > 0 then return end
	if speed < 0.2 then
		self.is_moving = false
		self.damage_dealt = false
		go.set("#collisionobject", "linear_velocity", vmath.vector3(0, 0, 0))
		msg.post("/unit_manager#unit_manager", "unit_stopped", { id = go.get_id() })
	end
end

function on_message(self, message_id, message, sender)

	-- 1. ЛОГИКА ПОЛЁТА (Импульс)
	if message_id == hash("apply_impulse") then
		self.is_moving = true
		self.damage_dealt = false -- Сбрасываем флаг атаки для нового броска

		local move_speed = 600 
		local dir = vmath.normalize(message.vector)
		go.set("#collisionobject", "linear_velocity", dir * move_speed)
		print("[FLY] Старт полёта от " .. go.get_id())

		-- 2. ЛОГИКА АТАКИ (Я во что-то врезался)
	elseif message_id == hash("contact_point_response") then
		-- Условия атаки:
		-- - Я двигаюсь (is_moving)
		-- - Сейчас ход МОЕЙ команды (state.current_team == self.team_type)
		-- - Я еще не наносил урон в этом полете (not self.damage_dealt)
		-- - Я врезался именно в юнита
		if state.current_team == self.team_type 
		and  message.group == hash("unit") then

			-- Проверяем, что цель — ВРАГ (не своя команда)
			local target_team = go.get(msg.url(nil, message.other_id, "unit"), "team_type")
			if target_team ~= self.team_type then
			--	self.damage_dealt = true -- Помечаем, что атака совершена (чтобы не бить 10 раз за полет)
				msg.post(message.other_id, "take_damage", { amount = self.damage })
				print("[ATTACK] Юнит " .. go.get_id() .. " ударил врага " .. message.other_id)
			end
		end

		-- 3. ЛОГИКА ПОЛУЧЕНИЯ УРОНА (В меня врезались)
	elseif message_id == hash("take_damage") then
		-- Условие получения урона:
		-- - Сейчас ход НЕ МОЕЙ команды (state.current_team ~= self.team_type)
		if state.current_team ~= self.team_type then
			self.current_hp = self.current_hp - message.amount

			-- Визуальные эффекты
			update_hp_bar(self)
			--show_damage_fx(self, message.amount) -- Вынеси создание цифр в функцию для чистоты

			if self.current_hp <= 0 then
				msg.post("/unit_manager#unit_manager", "unit_died", { id = go.get_id(), team = self.team_type })
				go.delete()
			end
		else
			print("[BLOCK] Игнорируем урон (дружественный огонь или свой ход)")
		end
	end
end