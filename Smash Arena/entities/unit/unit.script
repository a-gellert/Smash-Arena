-- unit.script
local state = require "main.state"
local data = require "main.heroes_data"
local unit_manager = require "main.unit_manager" -- Для регистрации в БД
local sound = require "main.sound"
local rendercam = require "rendercam.rendercam"

go.property("team_type", 1)
go.property("max_hp", 145)
go.property("damage", 20)
go.property("hero_id", 1)
go.property("level", 1)

-- Кэшируем URL гейм-менеджера, чтобы не искать его каждый раз
local GAME_MANAGER = "main:/game_manager"

function init(self)
	local base_data = data.heroes[self.hero_id]
	
	local stats = data.get_stats(self.hero_id, self.level)
	self.name = base_data.name_key
	self.max_hp = stats.hp
	self.current_hp = self.max_hp
	self.damage = stats.damage
	self.ability_value = base_data.ability_value
	self.ability_method = base_data.ability_method
	self.speed_multiplier = stats.speed
	self.is_dead = false
	print(self.name .. self.level)
	self.is_moving = false
	self.damage_dealt = false
	self.stop_timer = 0
	self.is_frozen = false
	self.is_enraged = false
	self.freeze_effect_id = nil
	self.rage_effect_id = nil
	self.constant_effect_id = nil
	self.effect_id = nil
	self.constant_trail_id = nil
	
	-- Визуал HP
--	go.set("#hp_fill", "tint", vmath.vector4(1, 0.15, 0.15, 1))
	
	go.cancel_animations("#outline", "tint")
	-- Уводим альфу в 0
	go.set("#outline", "tint.w", 0)
	
	-- 1. Регистрация в данных (Lua-модуль)
	unit_manager.register_unit(go.get_id(), 
	self.team_type, 
	self.hero_id, 
	self.level or 1, 
	self.current_hp)
	sprite.play_flipbook("#sprite", self.name)
	-- 2. Цвета команд
	if self.team_type == 1 then
	--	go.set("#platform", "tint", vmath.vector4(0.34, 0.35, 0.933, 1)) -- Синие (игрок)
		sprite.play_flipbook("#platform", "blue_platform")
	else
		--go.set("#platform", "tint", vmath.vector4(0.933, 0.35, 0.42, 1)) -- Красные (враг)
		sprite.play_flipbook("#platform", "red_platform")
	end
	self.color = go.get("#platform", "tint")
	--label.set_text("#name", data.get_name(self.hero_id, "en"))
end

function final(self)
	if self.freeze_effect_id and go.exists(self.freeze_effect_id) then
		pcall(go.delete, self.freeze_effect_id)
		self.freeze_effect_id = nil
	end
	if self.rage_effect_id and go.exists(self.rage_effect_id) then
		pcall(go.delete, self.rage_effect_id)
		self.rage_effect_id = nil
	end
	if self.constant_effect_id and go.exists(self.constant_effect_id) then
		pcall(go.delete, self.constant_effect_id)
		self.constant_effect_id = nil
	end
	if self.effect_id and go.exists(self.effect_id) then
		pcall(go.delete, self.effect_id)
		self.effect_id = nil
	end
	if self.constant_trail_id and go.exists(self.constant_trail_id) then
		pcall(go.delete, self.constant_trail_id)
		self.constant_trail_id = nil
	end
end


local function update_hp_bar(self)
	local quota = math.max(0, self.current_hp / self.max_hp)
	go.set("#hp_fill", "scale.x",  quota * 5.7)
end

local function show_damage_fx(self, amount, is_heal, custom_color)
	local p = go.get_world_position()
	p.x = p.x + math.random(-30, 30)
	p.y = p.y + 20

	local damage_obj = factory.create("#damage_factory", p)
	local label_url = msg.url(nil, damage_obj, "label")

	-- Определяем текст и цвет
	local text = ""
	local color = custom_color or vmath.vector4(1, 1, 1, 1) -- Белый по умолчанию

	if not custom_color then
		if is_heal then
			text = "+" .. tostring(amount)
			color = vmath.vector4(0.2, 1, 0.2, 1) -- Зеленый
		elseif type(amount) == "string" then
			text = tostring(amount)
			color = vmath.vector4(1, 0.2, 0.2, 1)
		else
			text = "-" .. tostring(amount)
			color = vmath.vector4(1, 0.2, 0.2, 1) -- Красный
		end
	else
		text = tostring(amount)
	end

	label.set_text(label_url, text)
	-- Устанавливаем цвет текста
	go.set(label_url, "color", color)
end

local function update_rage_state(self)
	if self.ability_method ~= "rage_damage" then
		return
	end

	local is_enraged_now = (self.current_hp / self.max_hp * 100) < self.ability_value
	if is_enraged_now and not self.is_enraged then
		self.is_enraged = true
		local pos = go.get_world_position()
		pos.z = pos.z - 0.1 -- Слой чуть выше юнита

		local props = {
			name = hash("rage")
		}

		if not self.rage_effect_id then
			self.rage_effect_id = factory.create("#effect_constant_factory", pos, nil, props, 1.0)
			msg.post(self.rage_effect_id, "set_parent", { parent_id = go.get_id(), keep_world_transform = 1 })
		end

		show_damage_fx(self, "RAGE!", false, vmath.vector4(1.0, 0.25, 0.1, 1.0))

		if not self.is_frozen then
			go.cancel_animations("#sprite", "tint")
			go.animate("#sprite", "tint", go.PLAYBACK_LOOP_PINGPONG, vmath.vector4(1.25, 0.7, 0.6, 1.0), go.EASING_INOUTSINE, 0.6)
			go.cancel_animations("#outline", "tint")
			go.set("#outline", "tint", vmath.vector4(1.0, 0.2, 0.1, 0.85))
			go.animate("#outline", "tint.w", go.PLAYBACK_LOOP_PINGPONG, 0.35, go.EASING_INOUTSINE, 0.7)
		end
	elseif not is_enraged_now and self.is_enraged then
		self.is_enraged = false
		if self.rage_effect_id and go.exists(self.rage_effect_id) then
			pcall(go.delete, self.rage_effect_id)
			self.rage_effect_id = nil
		end
		if not self.is_frozen then
			go.cancel_animations("#sprite", "tint")
			go.animate("#sprite", "tint", go.PLAYBACK_ONCE_FORWARD, vmath.vector4(1, 1, 1, 1), go.EASING_OUTQUAD, 0.3)
			go.cancel_animations("#outline", "tint")
			go.set("#outline", "tint.w", 0)
		end
	end
end

-- Вспомогательная функция лечения
local function heal(self, amount)
	-- 1. Считаем, сколько реально можем восстановить до капа
	local missing_hp = self.max_hp - self.current_hp

	-- 2. Если лечить нечего (уже фулл хп), просто выходим
	if missing_hp <= 0 then
		return
	end
	local pos = go.get_world_position()
	pos.z = pos.z + 0.1 -- Слой чуть выше юнита

	-- 2. Свойства для передачи в новый объект
	-- В factory.create последний аргумент - это свойства (properties)
	local props = {
		name =  hash("heal") 
	}

	-- 3. СОЗДАНИЕ ЧЕРЕЗ ФАБРИКУ
	-- factory.create(url, [pos], [rot], [properties], [scale])
	self.effect_id = factory.create("#effect_one_shot_factory", pos, nil, props, 1.0)
	msg.post(self.effect_id, "set_parent", { parent_id = go.get_id(), keep_world_transform = 1 })
	
	-- 3. Выбираем меньшее из: "сколько просят" или "сколько не хватает"
	local actual_heal = math.min(amount, missing_hp)

	-- 4. Применяем лечение
	self.current_hp = self.current_hp + actual_heal

	local radius = 70 -- Используем значение способности как радиус
	local target_scale = radius / 32   -- Т.к. спрайт 64x64, его радиус 32

	-- 2. Визуальный эффект (спрайт #effect)
	-- Сбрасываем состояние
	go.set("#effect", "scale", vmath.vector3(0, 0, 1))
	go.set("#effect", "tint", vmath.vector4(.2, .9, .21, 1))

	-- Анимация расширения и затухания
	go.animate("#effect", "scale", go.PLAYBACK_ONCE_FORWARD, vmath.vector3(target_scale, target_scale, 1), go.EASING_OUTQUAD, 0.4)
	go.animate("#effect", "tint.w", go.PLAYBACK_ONCE_FORWARD, 0, go.EASING_OUTQUAD, 0.4)
	
	-- 5. Визуал: передаем именно actual_heal, чтобы не вводить игрока в заблуждение
	unit_manager.update_hp(go.get_id(), self.current_hp)
	update_hp_bar(self)
	show_damage_fx(self, actual_heal, true)
	update_rage_state(self)

end
function update(self, dt)
	if not self.is_moving then return end

	local vel = go.get("#collisionobject", "linear_velocity")
	local speed = vmath.length(vel)

	if self.stop_timer > 0 then
		self.stop_timer = self.stop_timer - dt
		return
	end

	-- Если скорость упала - сообщаем гейм-менеджеру
	if speed < 0.1 then
		self.is_moving = false
		go.set("#collisionobject", "linear_velocity", vmath.vector3(0, 0, 0))
		particlefx.stop("#trail")
		-- УМЕНИЕ: Паладин (Heal on stop)
		if self.ability_method == "heal_on_stop" then
			heal(self, self.ability_value)
			timer.delay(1, false, function()
				msg.post(GAME_MANAGER, "unit_stopped", { id = go.get_id() })
			end)
			-- УМЕНИЕ: Танк (Wave/Heavy Impact - отталкивание в конце хода)
		elseif self.ability_method == "heavy_impact" then
			-- 1. Расчеты радиуса
			local radius = 150
			local target_scale = radius / 32

			-- 2. Визуальный эффект: анимация сжатия/топота Танка (squash & stretch)
			go.animate("#sprite", "scale.x", go.PLAYBACK_ONCE_PINGPONG, 0.28, go.EASING_OUTBOUNCE, 0.25)
			go.animate("#sprite", "scale.y", go.PLAYBACK_ONCE_PINGPONG, 0.13, go.EASING_OUTBOUNCE, 0.25)

			-- Золотисто-огненная ударная волна (#effect)
			go.set("#effect", "scale", vmath.vector3(0.1, 0.1, 1))
			go.set("#effect", "tint", vmath.vector4(1.0, 0.72, 0.18, 0.95))
			go.animate("#effect", "scale", go.PLAYBACK_ONCE_FORWARD, vmath.vector3(target_scale * 1.1, target_scale * 1.1, 1), go.EASING_OUTQUAD, 0.35)
			go.animate("#effect", "tint.w", go.PLAYBACK_ONCE_FORWARD, 0, go.EASING_OUTQUAD, 0.35)

			-- Сокрушительный звук удара и сотрясение экрана
			sound.play_bounce(true)
			pcall(rendercam.shake, 9, 0.22)

			-- 3. Сообщение в GameManager с передачей радиуса
			msg.post(GAME_MANAGER, "trigger_wave", { 
				pos = go.get_world_position(), 
				owner_id = go.get_id(), 
				force = self.ability_value,
				radius = radius
			})

			-- Динамичная передача хода через 0.55с вместо прежней задержки 2 секунды
			timer.delay(0.55, false, function()
				if self.constant_trail_id then
					local ok, err = pcall(go.delete, self.constant_trail_id)
					if not ok then
						print("Эффект уже был удален или недоступен: " .. tostring(err))
					end
					self.constant_trail_id = nil
				end
				msg.post(GAME_MANAGER, "unit_stopped", { id = go.get_id() })
			end)
		else
			-- Оповещаем Game Manager, что этот юнит закончил движение
			msg.post(GAME_MANAGER, "unit_stopped", { id = go.get_id() })
		end
	end
end

function on_message(self, message_id, message, sender)
	-- 1. Импульс от игрока или ИИ
	if message_id == hash("apply_impulse") then
		local props = { name = hash("trail") }
		particlefx.play("#trail")
		if not self.constant_trail_id then

			local current_pos = go.get_world_position() -- Получаем позицию юнита
			current_pos.z = current_pos.z -  0.95
		--	self.constant_trail_id = factory.create("#effect_trail_factory", current_pos, nil, props, 1.0)
			print(current_pos)
		--	msg.post(self.constant_trail_id, "set_parent", { parent_id = go.get_id(), keep_world_transform = 1 })
		end
		go.cancel_animations("#outline", "tint")
		-- Уводим альфу в 0
		go.set("#outline", "tint.w", 0)
		self.stop_timer = 1
		self.is_moving = true
		self.damage_dealt = false
		local base_move_speed = 1000 * self.speed_multiplier

		-- Если нас заморозил Маг Льда
		if self.is_frozen then
			base_move_speed = base_move_speed * 0.5
			self.is_frozen = false -- Эффект на один ход
			if self.freeze_effect_id then
				local ok, err = pcall(go.delete, self.freeze_effect_id)
				if not ok then
					print("Эффект уже был удален или недоступен: " .. tostring(err))
				end
				self.freeze_effect_id = nil
			end
			if self.constant_effect_id then
				pcall(go.delete, self.constant_effect_id)
				self.constant_effect_id = nil
			end
			-- Разморозка: всплеск разлетающихся осколков льда
			go.set("#effect", "scale", vmath.vector3(0, 0, 1))
			go.set("#effect", "tint", vmath.vector4(0.4, 0.85, 1.0, 0.9))
			go.animate("#effect", "scale", go.PLAYBACK_ONCE_FORWARD, vmath.vector3(2.5, 2.5, 1), go.EASING_OUTQUAD, 0.3)
			go.animate("#effect", "tint.w", go.PLAYBACK_ONCE_FORWARD, 0, go.EASING_OUTQUAD, 0.3)

			-- Возвращаем цвет спрайта
			go.cancel_animations("#sprite", "tint")
			if self.is_enraged then
				go.animate("#sprite", "tint", go.PLAYBACK_LOOP_PINGPONG, vmath.vector4(1.25, 0.7, 0.6, 1.0), go.EASING_INOUTSINE, 0.6)
				go.cancel_animations("#outline", "tint")
				go.set("#outline", "tint", vmath.vector4(1.0, 0.2, 0.1, 0.85))
				go.animate("#outline", "tint.w", go.PLAYBACK_LOOP_PINGPONG, 0.35, go.EASING_INOUTSINE, 0.7)
			else
				go.animate("#sprite", "tint", go.PLAYBACK_ONCE_FORWARD, vmath.vector4(1, 1, 1, 1), go.EASING_OUTQUAD, 0.3)
				go.cancel_animations("#outline", "tint")
				go.set("#outline", "tint.w", 0)
			end
			print("frozen" .. base_move_speed)
		end

		-- Вектор уже должен приходить нормализованным из менеджера, но на всякий случай:
		local dir = vmath.normalize(message.vector)
		go.set("#collisionobject", "linear_velocity", dir * base_move_speed)

		-- 2. Столкновение (Атака)
	elseif message_id == hash("contact_point_response") then
		if message.group == hash("unit") then
			self.stop_timer = 1
			-- Проверяем команду цели
			local target_url = msg.url(nil, message.other_id, "unit")
			local target_team = go.get(target_url, "team_type")

			if target_team ~= self.team_type and state.current_team == self.team_type then
				local final_damage = self.damage
				local hit_gain = 1.0
				-- УМЕНИЕ: Берсерк (Rage)
				if self.ability_method == "rage_damage" and (self.current_hp / self.max_hp * 100) < self.ability_value then
					final_damage = final_damage * 2
					hit_gain = 1.25
				end

				-- Сочный звук удара!
				sound.play_hit(hit_gain)

				msg.post(message.other_id, "take_damage", { amount = final_damage, attacker_id = go.get_id() })

				-- УМЕНИЕ: Вампир (Life Leech)
				if self.ability_method == "life_leech" then
					local life_steal = math.floor(final_damage * (self.ability_value / 100))
					heal(self, life_steal)

					-- УМЕНИЕ: Маг Льда (Freeze)	
				elseif self.ability_method == "freeze_hit" then
					msg.post(message.other_id, "apply_freeze", { slow_factor = self.ability_value / 100 })
				end
			elseif target_team == self.team_type and state.current_team == self.team_type then
				-- Соударение с союзником: воспроизводим звук отскока только при реальном ударе
				if message.applied_impulse and message.applied_impulse > 10 then
					sound.play_bounce(false)
				end

				-- УМЕНИЕ: Монах (Prayer - хил союзника при контакте)
				if self.ability_method == "touch_heal" then
					print("touch_heal" .. self.ability_value)
					msg.post(message.other_id, "heal", { amount = self.ability_value })
				end
			end
		elseif message.group == hash("wall") then
			-- Отскок от стены арены (только при реальном динамическом соударении)
			if message.applied_impulse and message.applied_impulse > 15 then
				local is_heavy = message.applied_impulse > 350
				sound.play_bounce(is_heavy)
			end
		end

		-- 3. Получение урона
	elseif message_id == hash("take_damage") then
		if state.current_team ~= self.team_type then
			-- УМЕНИЕ: Призрак (Evasion)
			if self.ability_method == "evasion" and math.random(1, 100) <= self.ability_value then
				show_damage_fx(self, "MISS", false)
				return
			end

			local pos = go.get_world_position()
			pos.z = pos.z + 0.1 -- Слой чуть выше юнита

			-- 2. Свойства для передачи в новый объект
			-- В factory.create последний аргумент - это свойства (properties)
			local props = {
				name =  hash("damage") 
			}

			-- 3. СОЗДАНИЕ ЧЕРЕЗ ФАБРИКУ
			-- factory.create(url, [pos], [rot], [properties], [scale])
			self.effect_id = factory.create("#effect_one_shot_factory", pos, nil, props, 1.0)
			msg.post(self.effect_id, "set_parent", { parent_id = go.get_id(), keep_world_transform = 1 })
			
			self.current_hp = self.current_hp - message.amount
			unit_manager.update_hp(go.get_id(), self.current_hp)

			local radius = 70 -- Используем значение способности как радиус
			local target_scale = radius / 32   -- Т.к. спрайт 64x64, его радиус 32

			-- 2. Визуальный эффект (спрайт #effect)
			-- Сбрасываем состояние
			go.set("#effect", "scale", vmath.vector3(0, 0, 1))
			go.set("#effect", "tint", vmath.vector4(.9, .3, .21, 1))
			go.animate("#effect", "scale", go.PLAYBACK_ONCE_FORWARD, vmath.vector3(target_scale, target_scale, 1), go.EASING_OUTQUAD, 0.4)
			go.animate("#effect", "tint.w", go.PLAYBACK_ONCE_FORWARD, 0, go.EASING_OUTQUAD, 0.4)

			-- Вспышка урона с сохранением тинта заморозки / ярости
			go.cancel_animations("#sprite", "tint")
			local base_tint = vmath.vector4(1, 1, 1, 1)
			if self.is_frozen then
				base_tint = vmath.vector4(0.45, 0.75, 1.25, 1.0)
			elseif self.is_enraged then
				base_tint = vmath.vector4(1.25, 0.7, 0.6, 1.0)
			end
			go.set("#sprite", "tint", base_tint)
			go.animate("#sprite", "tint", go.PLAYBACK_ONCE_PINGPONG, vmath.vector4(3, 3, 3, 1), go.EASING_INOUTSINE, 0.2, 0, function()
				if self.is_frozen then
					go.set("#sprite", "tint", vmath.vector4(0.45, 0.75, 1.25, 1.0))
				elseif self.is_enraged then
					go.animate("#sprite", "tint", go.PLAYBACK_LOOP_PINGPONG, vmath.vector4(1.25, 0.7, 0.6, 1.0), go.EASING_INOUTSINE, 0.6)
				else
					go.set("#sprite", "tint", vmath.vector4(1, 1, 1, 1))
				end
			end)
			
			update_hp_bar(self)
			show_damage_fx(self, message.amount, false)
			update_rage_state(self)

			if self.current_hp <= 0 then
				-- УМЕНИЕ: Подрывник (Explosion on death)
				if self.ability_method == "death_explosion" then
					msg.post(GAME_MANAGER, "trigger_explosion", { 
						pos = go.get_world_position(), 
						damage = self.ability_value,
						radius = 160,
						owner_id = go.get_id()
					})
				end
				if self.effect_id and go.exists(self.effect_id) then
					pcall(go.delete, self.effect_id)
					self.effect_id = nil
				end
				if self.freeze_effect_id and go.exists(self.freeze_effect_id) then
					pcall(go.delete, self.freeze_effect_id)
					self.freeze_effect_id = nil
				end
				if self.rage_effect_id and go.exists(self.rage_effect_id) then
					pcall(go.delete, self.rage_effect_id)
					self.rage_effect_id = nil
				end
				if self.constant_effect_id and go.exists(self.constant_effect_id) then
					pcall(go.delete, self.constant_effect_id)
					self.constant_effect_id = nil
				end
				if self.constant_trail_id and go.exists(self.constant_trail_id) then
					pcall(go.delete, self.constant_trail_id)
					self.constant_trail_id = nil
				end
				-- Сообщаем менеджеру о смерти, чтобы он удалил нас из очереди
				local my_id = go.get_id()
				local death_pos = go.get_world_position()
				local is_last_enemy = (self.team_type == 2 and #unit_manager.teams[2] == 1 and #unit_manager.teams[1] > 0)

				msg.post(GAME_MANAGER, "unit_died", { id = my_id, killer_id = sender, team = self.team_type, pos = death_pos })

				if is_last_enemy then
					-- Кинематографическое растворение последнего врага
					go.cancel_animations("#sprite", "tint")
					go.set("#sprite", "tint", vmath.vector4(2.5, 2.5, 2.5, 1.0))
					pcall(go.animate, "#sprite", "scale", go.PLAYBACK_ONCE_FORWARD, vmath.vector3(1.35, 1.35, 1), go.EASING_OUTQUAD, 0.4)
					pcall(go.animate, "#sprite", "tint.w", go.PLAYBACK_ONCE_FORWARD, 0, go.EASING_INQUAD, 0.45, 0.1, function()
						if go.exists(my_id) then
							go.delete(my_id, true)
						end
					end)
				else
					go.delete(my_id, true)
				end
				return
			end
		end
	elseif message_id == hash("apply_freeze") and state.current_team ~= self.team_type then
		if self.ability_method == "stationary_shield" then
			show_damage_fx(self, "BLOCK", false)
			return
		end
		local pos = go.get_world_position()
		pos.z = pos.z - 0.1 -- Слой чуть выше юнита

		-- 2. Свойства для передачи в новый объект
		-- В factory.create последний аргумент - это свойства (properties)
		local props = {
			name =  hash("freeze") 
		}

		-- 3. СОЗДАНИЕ ЧЕРЕЗ ФАБРИКУ
		-- factory.create(url, [pos], [rot], [properties], [scale])
		if not self.freeze_effect_id then
			self.freeze_effect_id = factory.create("#effect_constant_factory", pos, nil, props, 1.0)
			msg.post(self.freeze_effect_id, "set_parent", { parent_id = go.get_id(), keep_world_transform = 1 })
		end
		self.is_frozen = true
		show_damage_fx(self, "FREEZE!", false, vmath.vector4(0.3, 0.8, 1.0, 1.0))

		-- Визуальное оледенение спрайта юнита и ледяная аура
		go.cancel_animations("#sprite", "tint")
		go.set("#sprite", "tint", vmath.vector4(0.45, 0.75, 1.25, 1.0))
		go.cancel_animations("#outline", "tint")
		go.set("#outline", "tint", vmath.vector4(0.25, 0.85, 1.0, 0.85))
		go.animate("#outline", "tint.w", go.PLAYBACK_LOOP_PINGPONG, 0.35, go.EASING_INOUTSINE, 1.0)

		local radius = 70 -- Используем значение способности как радиус
		local target_scale = radius / 32   -- Т.к. спрайт 64x64, его радиус 32

		-- 2. Визуальный эффект (спрайт #effect)
		-- Сбрасываем состояние
		go.set("#effect", "scale", vmath.vector3(0, 0, 1))
		go.set("#effect", "tint", vmath.vector4(.2, .6, 1.0, 1))

		-- Анимация расширения и затухания
		go.animate("#effect", "scale", go.PLAYBACK_ONCE_FORWARD, vmath.vector3(target_scale, target_scale, 1), go.EASING_OUTQUAD, 0.4)
		go.animate("#effect", "tint.w", go.PLAYBACK_ONCE_FORWARD, 0, go.EASING_OUTQUAD, 0.4)
		
		print("isfrozen")
	elseif message_id == hash("heal") and state.current_team == self.team_type then
		heal(self, message.amount)
	
	elseif message_id == hash("heal_reaper") and state.current_team == self.team_type then
		heal(self, self.ability_value)
	elseif message_id == hash("set_active") then
		-- 1. Всегда отменяем старую анимацию, чтобы не плодить слои
		go.cancel_animations("#outline", "tint")

		if message.active then
			if self.is_frozen then
				go.set("#outline", "tint", vmath.vector4(0.25, 0.85, 1.0, 1.0))
				go.animate("#outline", "tint.w", go.PLAYBACK_LOOP_PINGPONG, 0.4, go.EASING_INOUTSINE, 0.8)
			elseif self.is_enraged then
				go.set("#outline", "tint", vmath.vector4(1.0, 0.2, 0.1, 1.0))
				go.animate("#outline", "tint.w", go.PLAYBACK_LOOP_PINGPONG, 0.4, go.EASING_INOUTSINE, 0.6)
			else
				go.set("#outline", "tint", vmath.vector4(1.0, 1.0, 1.0, 1.0))
				go.animate("#outline", "tint.w", go.PLAYBACK_LOOP_PINGPONG, 0.5, go.EASING_INOUTSINE, 1.0)
			end
		else
			if self.is_frozen then
				go.set("#outline", "tint", vmath.vector4(0.25, 0.85, 1.0, 0.7))
				go.animate("#outline", "tint.w", go.PLAYBACK_LOOP_PINGPONG, 0.3, go.EASING_INOUTSINE, 1.2)
			elseif self.is_enraged then
				go.set("#outline", "tint", vmath.vector4(1.0, 0.2, 0.1, 0.7))
				go.animate("#outline", "tint.w", go.PLAYBACK_LOOP_PINGPONG, 0.3, go.EASING_INOUTSINE, 0.8)
			else
				go.set("#outline", "tint.w", 0)
			end
		end
	end
end
