[bootstrap]
main_collection = /main/main.collectionc
render = /rendercam/rendercam.renderc

[script]
shared_state = 1

[display]
width = 780
height = 1560
high_dpi = 1

[physics]
gravity_y = 0.0
scale = 0.01
debug = 0

[html5]
scale_mode = stretch
show_made_with_defold = 0
show_console_banner = 0
show_fullscreen_button = 0
htmlfile = /bridge/engine_template.html
cssfile = /builtins/manifests/web/dark_theme.css

[project]
title = Smash Arena
bundle_resources = /res
compress_archive = 1
dependencies#0 = https://github.com/Insality/defold-event/archive/refs/tags/14.zip
dependencies#1 = https://github.com/rgrams/rendercam/archive/1.0.3.zip
dependencies#2 = https://github.com/Insality/druid/archive/refs/tags/1.2.1.zip
dependencies#3 = https://github.com/Playgama/bridge-defold/archive/refs/tags/v2.2.0.zip
dependencies#4 = https://github.com/AGulev/defold-extension-unity-ads/archive/refs/tags/4.19.0.zip

[sound]
gain = 1.0
max_sound_data = 16
max_sound_instances = 128
max_sound_sources = 16

[android]
version_code = 26
package = best.pvp.smasharena.battle
minimum_sdk_version = 24
app_icon_192x192 = /assets/result_result_icon.png
app_icon_144x144 = /assets/result_result_icon.png
app_icon_96x96 = /assets/result_result_icon.png
app_icon_72x72 = /assets/result_result_icon.png
app_icon_48x48 = /assets/result_result_icon.png
app_icon_36x36 = /assets/result_result_icon.png

[collection_proxy]
max_count = 16

[unityads]
tracking_usage_description = 1946032
game_id_android = 6194929
game_id_ios = 6194928
test_mode = 0
interstitial_placement = Interstitial_Android
rewarded_placement = Rewarded_Android
banner_placement = Banner_Android

