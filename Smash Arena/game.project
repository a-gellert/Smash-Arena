[bootstrap]
main_collection = /main/main.collectionc
render = /rendercam/rendercam.renderc

[script]
shared_state = 1

[display]
width = 780
height = 1560
high_dpi = 1

[physics]
gravity_y = 0.0
scale = 0.01
debug = 0

[html5]
scale_mode = stretch
show_made_with_defold = 0
show_console_banner = 0
show_fullscreen_button = 0
htmlfile = /res/web/engine_template.html
cssfile = /builtins/manifests/web/dark_theme.css

[project]
title = Smash Arena
bundle_resources = /res
compress_archive = 1
dependencies#0 = https://github.com/Insality/defold-event/archive/refs/tags/14.zip
dependencies#1 = https://github.com/Insality/druid/archive/refs/tags/1.2.1.zip
dependencies#2 = https://github.com/Playgama/bridge-defold/archive/refs/tags/v2.2.0.zip
dependencies#3 = https://github.com/AGulev/defold-extension-unity-ads/archive/refs/tags/4.19.0.zip
dependencies#4 = https://github.com/GameAnalytics/GA-SDK-DEFOLD/archive/master.zip
dependencies#5 = https://github.com/defold/extension-facebook/archive/refs/tags/10.0.0.zip

[adjust]
app_token = 3fybji2hz728
environment = production
log_level = info

[sound]
gain = 1.0
max_sound_data = 16
max_sound_instances = 128
max_sound_sources = 16

[android]
